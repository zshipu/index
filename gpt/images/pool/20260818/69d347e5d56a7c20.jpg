<svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p8Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="400" rx="12" fill="#f8f9ff"/>
  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">注册与卸载的自动清理</text>

  <rect x="240" y="44" width="320" height="66" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="400" y="70" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">插件加载 apply(ctx)</text>
  <text x="400" y="92" text-anchor="middle" font-size="10" fill="#2a7a3a">通过 ctx 注册三类资源</text>

  <line x1="400" y1="110" x2="400" y2="138" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p8Arrow)"/>

  <rect x="200" y="142" width="400" height="66" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="400" y="168" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">运行中：所有注册被自动追踪</text>
  <text x="400" y="190" text-anchor="middle" font-size="10" fill="#2a5aa0">ctx.on / ctx.tools.register / ctx.effect</text>

  <line x1="400" y1="208" x2="400" y2="236" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p8Arrow)"/>

  <rect x="200" y="240" width="400" height="66" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="400" y="266" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">插件卸载（自动清理）</text>
  <text x="400" y="288" text-anchor="middle" font-size="10" fill="#a04000">无需手动 removeListener 或 clearInterval</text>

  <line x1="400" y1="306" x2="400" y2="334" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p8Arrow)"/>

  <rect x="100" y="338" width="600" height="52" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="400" y="360" text-anchor="middle" font-size="11" font-weight="bold" fill="#334155">清理动作</text>
  <text x="400" y="380" text-anchor="middle" font-size="10" fill="#64748b">事件监听移除 · 工具注册撤销 · disposer 执行（clearInterval）</text>
</svg>
