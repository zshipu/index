<svg viewBox="0 0 800 640" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="s20Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="640" rx="12" fill="#f8f9ff"/>

  <text x="400" y="26" text-anchor="middle" font-size="15" font-weight="bold" fill="#334155">StreamChunk 分片序列（自上而下按产出顺序）</text>

  <!-- 阶段标签 -->
  <text x="30" y="160" font-size="12" font-weight="bold" fill="#2a5aa0">文本块</text>
  <text x="30" y="178" font-size="10.5" fill="#64748b">text</text>
  <text x="30" y="376" font-size="12" font-weight="bold" fill="#a04000">工具调用块</text>
  <text x="30" y="394" font-size="10.5" fill="#64748b">tool-call</text>
  <text x="30" y="540" font-size="12" font-weight="bold" fill="#7a30b0">收尾</text>

  <!-- 阶段括号 -->
  <path d="M 140 60 L 140 268" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="60" x2="140" y2="60" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="268" x2="140" y2="268" stroke="#94a3b8" stroke-width="1.5"/>
  <path d="M 140 300 L 140 452" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="300" x2="140" y2="300" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="452" x2="140" y2="452" stroke="#94a3b8" stroke-width="1.5"/>
  <path d="M 140 488 L 140 584" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="488" x2="140" y2="488" stroke="#94a3b8" stroke-width="1.5"/>
  <line x1="130" y1="584" x2="140" y2="584" stroke="#94a3b8" stroke-width="1.5"/>

  <!-- 分片 1：block-start 文本 -->
  <rect x="170" y="60" width="480" height="40" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="410" y="77" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">block-start</text>
  <text x="410" y="93" text-anchor="middle" font-size="10" fill="#2a5aa0">{ index: 0, blockType: 'text' }</text>

  <!-- 分片 2：text-delta -->
  <rect x="170" y="116" width="480" height="40" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="410" y="133" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">text-delta</text>
  <text x="410" y="149" text-anchor="middle" font-size="10" fill="#2a5aa0">{ index: 0, text: 'runoob' }</text>

  <!-- 分片 3：text-delta -->
  <rect x="170" y="172" width="480" height="40" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="410" y="189" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">text-delta</text>
  <text x="410" y="205" text-anchor="middle" font-size="10" fill="#2a5aa0">{ index: 0, text: ' 教程' }</text>

  <!-- 分片 4：block-end 文本 -->
  <rect x="170" y="228" width="480" height="40" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="410" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">block-end</text>
  <text x="410" y="261" text-anchor="middle" font-size="10" fill="#2a5aa0">{ index: 0, block: { type: 'text', text: 'runoob 教程' } }</text>

  <!-- 分片 5：block-start 工具调用 -->
  <rect x="170" y="300" width="480" height="40" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="410" y="317" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">block-start</text>
  <text x="410" y="333" text-anchor="middle" font-size="10" fill="#a04000">{ index: 1, blockType: 'tool-call' }</text>

  <!-- 分片 6：tool-call-delta -->
  <rect x="170" y="356" width="480" height="40" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="410" y="373" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">tool-call-delta</text>
  <text x="410" y="389" text-anchor="middle" font-size="10" fill="#a04000">{ index: 1, name: 'bash', argumentsDelta: '{"command":"echo runoob"}' }</text>

  <!-- 分片 7：block-end 工具调用 -->
  <rect x="170" y="412" width="480" height="40" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="410" y="429" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">block-end</text>
  <text x="410" y="445" text-anchor="middle" font-size="10" fill="#a04000">{ index: 1, block: { type: 'tool-call', name: 'bash', arguments: '{"command":"echo runoob"}' } }</text>

  <!-- 分片 8：usage -->
  <rect x="170" y="488" width="480" height="40" rx="8" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="410" y="505" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">usage</text>
  <text x="410" y="521" text-anchor="middle" font-size="10" fill="#2a7a3a">{ usage: { inputTokens: 100, outputTokens: 50 } }</text>

  <!-- 分片 9：finish -->
  <rect x="170" y="544" width="480" height="40" rx="8" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="410" y="561" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">finish</text>
  <text x="410" y="577" text-anchor="middle" font-size="10" fill="#7a30b0">{ reason: { kind: 'stop' } }</text>

  <!-- 连接箭头 -->
  <line x1="410" y1="100" x2="410" y2="116" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="156" x2="410" y2="172" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="212" x2="410" y2="228" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="268" x2="410" y2="300" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="340" x2="410" y2="356" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="396" x2="410" y2="412" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="452" x2="410" y2="488" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>
  <line x1="410" y1="528" x2="410" y2="544" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s20Arrow)"/>

  <text x="400" y="616" text-anchor="middle" font-size="11" fill="#64748b">规则：block-start / block-end 成对 · index 从 0 递增 · finish 必须最后 · usage 在 finish 前</text>
</svg>
