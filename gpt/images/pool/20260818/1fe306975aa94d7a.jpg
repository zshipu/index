<svg viewBox="0 0 800 420" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="cloArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="420" rx="12" fill="#f8f9ff"/>

  <text x="400" y="28" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">配置加载顺序：空根之上逐层组合</text>

  <!-- 生效配置 -->
  <rect x="40" y="50" width="640" height="58" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="360" y="76" text-anchor="middle" font-size="13" font-weight="bold" fill="#5b1a8a">生效配置</text>
  <text x="360" y="96" text-anchor="middle" font-size="10.5" fill="#7a30b0">后应用的层按行胜出</text>

  <!-- 第 4 层 -->
  <rect x="40" y="124" width="640" height="46" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="360" y="153" text-anchor="middle" font-size="11.5" fill="#8a3a00">第 4 层：每个 --patch overlay（按 argv 顺序）</text>

  <!-- 第 3 层 -->
  <rect x="40" y="186" width="640" height="46" rx="10" fill="#e6f7f6" stroke="#0e9488" stroke-width="1.5"/>
  <text x="360" y="215" text-anchor="middle" font-size="11.5" fill="#0f766e">第 3 层：home 级 $DSH_HOME/cordis.patch.yml</text>

  <!-- 第 2 层 -->
  <rect x="40" y="248" width="640" height="46" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="360" y="277" text-anchor="middle" font-size="11.5" fill="#1a5a2a">第 2 层：profile 自己的 cordis.patch.yml</text>

  <!-- 第 1 层 -->
  <rect x="40" y="310" width="640" height="46" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="360" y="339" text-anchor="middle" font-size="11.5" fill="#1a3a8a">第 1 层：profile 的 bundles patch，按列表序</text>

  <!-- 空根 -->
  <rect x="40" y="372" width="640" height="42" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="360" y="398" text-anchor="middle" font-size="11.5" fill="#64748b">空根（空配置）</text>

  <!-- 层间向上的箭头 -->
  <line x1="160" y1="122" x2="160" y2="112" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#cloArrow)"/>
  <line x1="160" y1="184" x2="160" y2="174" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#cloArrow)"/>
  <line x1="160" y1="246" x2="160" y2="236" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#cloArrow)"/>
  <line x1="160" y1="308" x2="160" y2="298" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#cloArrow)"/>
  <line x1="160" y1="370" x2="160" y2="360" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#cloArrow)"/>

  <!-- 右侧注解 -->
  <text x="694" y="80" font-size="10" fill="#64748b">结果：生效配置</text>
  <text x="694" y="153" font-size="10" fill="#64748b">覆盖，最后生效</text>
  <text x="694" y="215" font-size="10" fill="#64748b">跨 profile 共享</text>
  <text x="694" y="277" font-size="10" fill="#64748b">用户 profile 级</text>
  <text x="694" y="339" font-size="10" fill="#64748b">bundle 按加入序</text>
  <text x="694" y="398" font-size="10" fill="#64748b">叠加起点</text>
</svg>
