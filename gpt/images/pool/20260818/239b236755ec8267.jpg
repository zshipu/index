<svg viewBox="0 0 820 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p11Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="820" height="380" rx="12" fill="#f8f9ff"/>
  <text x="410" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">配置校验与 HMR 流程</text>

  <rect x="16" y="56" width="230" height="108" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="131" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">cordis.yml 用户配置</text>
  <text x="131" y="103" text-anchor="middle" font-size="10" fill="#64748b">id: hello</text>
  <text x="131" y="121" text-anchor="middle" font-size="10" fill="#64748b">config:</text>
  <text x="131" y="139" text-anchor="middle" font-size="9" fill="#64748b">greeting / maxRetries</text>

  <rect x="286" y="56" width="230" height="108" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="401" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">导出 Config 同名 schema</text>
  <text x="401" y="103" text-anchor="middle" font-size="10" fill="#2a5aa0">Schema.object({...})</text>
  <text x="401" y="121" text-anchor="middle" font-size="10" fill="#2a5aa0">默认值写在 schema</text>
  <text x="401" y="139" text-anchor="middle" font-size="9" fill="#2a5aa0">greeting 默认 'Hello'</text>

  <rect x="556" y="56" width="248" height="108" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="680" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">加载时校验</text>
  <text x="680" y="103" text-anchor="middle" font-size="10" fill="#2a5aa0">Standard Schema 校验</text>
  <text x="680" y="121" text-anchor="middle" font-size="10" fill="#2a5aa0">填充未提供字段默认值</text>
  <text x="680" y="139" text-anchor="middle" font-size="9" fill="#2a5aa0">不合法 → 加载失败并报错</text>

  <line x1="246" y1="110" x2="282" y2="110" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p11Arrow)"/>
  <line x1="516" y1="110" x2="552" y2="110" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p11Arrow)"/>

  <polyline points="680,164 680,184 201,184 201,204" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p11Arrow)"/>
  <polyline points="680,164 680,184 617,184 617,204" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p11Arrow)"/>

  <rect x="16" y="208" width="370" height="72" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="201" y="232" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">校验通过</text>
  <text x="201" y="252" text-anchor="middle" font-size="10" fill="#2a7a3a">填充默认值 → apply(ctx, config)</text>
  <text x="201" y="270" text-anchor="middle" font-size="10" fill="#2a7a3a">config 类型安全</text>

  <rect x="430" y="208" width="374" height="72" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="617" y="232" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">校验失败</text>
  <text x="617" y="252" text-anchor="middle" font-size="10" fill="#a04000">插件加载失败（FAILED）</text>
  <text x="617" y="270" text-anchor="middle" font-size="10" fill="#a04000">给出明确错误信息</text>

  <rect x="16" y="308" width="788" height="56" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="410" y="332" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">HMR：配置变更热替换</text>
  <text x="410" y="352" text-anchor="middle" font-size="10" fill="#7a30b0">卸载旧实例（注册自动清理）→ 加载新实例（执行新 apply）</text>
</svg>
