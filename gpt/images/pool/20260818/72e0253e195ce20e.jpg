<svg viewBox="0 0 800 290" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="f13Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="290" rx="12" fill="#fafbff"/>

  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">依赖驱动：服务消失自动卸载、恢复自动重载</text>

  <!-- 事件竖线 -->
  <line x1="380" y1="52" x2="380" y2="248" stroke="#e07b39" stroke-width="1.3" stroke-dasharray="5,4"/>
  <text x="380" y="47" text-anchor="middle" font-size="10" font-weight="bold" fill="#c2410c">服务消失</text>
  <text x="380" y="268" text-anchor="middle" font-size="10" fill="#c2410c">自动卸载依赖方</text>

  <line x1="560" y1="52" x2="560" y2="248" stroke="#27ae60" stroke-width="1.3" stroke-dasharray="5,4"/>
  <text x="560" y="47" text-anchor="middle" font-size="10" font-weight="bold" fill="#1a5a2a">服务恢复</text>
  <text x="560" y="268" text-anchor="middle" font-size="10" fill="#1a5a2a">自动重载依赖方</text>

  <!-- 泳道标签 -->
  <text x="20" y="92" font-size="12" font-weight="bold" fill="#475569">服务提供方</text>
  <text x="20" y="162" font-size="12" font-weight="bold" fill="#475569">依赖方插件</text>

  <!-- 服务提供方泳道 -->
  <rect x="120" y="70" width="260" height="36" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="250" y="93" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">ACTIVE</text>

  <rect x="380" y="70" width="180" height="36" rx="8" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1.3" stroke-dasharray="4,3"/>
  <text x="470" y="93" text-anchor="middle" font-size="10" fill="#64748b">服务消失（提供方被替换）</text>

  <rect x="560" y="70" width="220" height="36" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="670" y="93" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">ACTIVE（恢复）</text>

  <!-- 依赖方插件泳道 -->
  <rect x="120" y="140" width="260" height="36" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="250" y="163" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">ACTIVE</text>

  <rect x="380" y="140" width="60" height="36" rx="6" fill="#f5effe" stroke="#8e44ad" stroke-width="1.3"/>
  <text x="410" y="163" text-anchor="middle" font-size="8" font-weight="bold" fill="#5b1a8a">UNLOADING</text>

  <rect x="440" y="140" width="60" height="36" rx="6" fill="#f1f5f9" stroke="#64748b" stroke-width="1.3"/>
  <text x="470" y="163" text-anchor="middle" font-size="8" font-weight="bold" fill="#475569">DISPOSED</text>

  <rect x="500" y="140" width="60" height="36" rx="6" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="530" y="163" text-anchor="middle" font-size="8" font-weight="bold" fill="#475569">PENDING</text>

  <rect x="560" y="140" width="60" height="36" rx="6" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.3"/>
  <text x="590" y="163" text-anchor="middle" font-size="8" font-weight="bold" fill="#1a3a8a">LOADING</text>

  <rect x="620" y="140" width="160" height="36" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="700" y="163" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">ACTIVE</text>

  <!-- 图例 -->
  <text x="20" y="212" font-size="10" fill="#64748b">依赖方跟随服务生命周期自动迁移：ACTIVE → UNLOADING → DISPOSED →（等待）→ LOADING → ACTIVE</text>
  <text x="20" y="232" font-size="10" fill="#64748b">所有注册在卸载阶段被撤销，重载时重新注册，因此热替换不会残留旧实例</text>
</svg>
