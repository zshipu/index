<svg viewBox="0 0 800 560" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="sdkArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="560" rx="12" fill="#fafbff"/>

  <text x="400" y="32" text-anchor="middle" font-size="16" font-weight="bold" fill="#334155">Python SDK 调用流程</text>

  <!-- 主流程 -->
  <!-- 1 -->
  <rect x="140" y="56" width="320" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="300" y="80" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">DeepSeekHarness(...)</text>
  <text x="300" y="98" text-anchor="middle" font-size="11" fill="#2a5aa0">进入上下文管理器，声明 provider / model / cwd</text>
  <line x1="300" y1="112" x2="300" y2="132" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sdkArrow)"/>

  <!-- 2 -->
  <rect x="140" y="132" width="320" height="56" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="300" y="156" text-anchor="middle" font-size="13" font-weight="bold" fill="#5b1a8a">延迟启动内置运行时</text>
  <text x="300" y="174" text-anchor="middle" font-size="11" fill="#7a30b0">无需系统提供 Node.js，退出时自动释放</text>
  <line x1="300" y1="188" x2="300" y2="208" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sdkArrow)"/>

  <!-- 3 -->
  <rect x="140" y="208" width="320" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="300" y="232" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">harness.run(prompt, session_id)</text>
  <text x="300" y="250" text-anchor="middle" font-size="11" fill="#2a5aa0">发送任务；复用 session id 保留 Bash 进程</text>
  <line x1="300" y1="264" x2="300" y2="284" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sdkArrow)"/>

  <!-- 4 -->
  <rect x="140" y="284" width="320" height="56" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="2"/>
  <text x="300" y="308" text-anchor="middle" font-size="13" font-weight="bold" fill="#8a3a00">Agent 执行任务</text>
  <text x="300" y="326" text-anchor="middle" font-size="11" fill="#a04000">仅 bash 与 str_replace_editor 两个工具</text>
  <line x1="300" y1="340" x2="300" y2="360" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sdkArrow)"/>

  <!-- 5 -->
  <rect x="140" y="360" width="320" height="56" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="300" y="384" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">返回 result.final_response</text>
  <text x="300" y="402" text-anchor="middle" font-size="11" fill="#2a7a3a">在程序里打印最终回复</text>
  <line x1="300" y1="416" x2="300" y2="436" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#sdkArrow)"/>

  <!-- 6 -->
  <rect x="140" y="436" width="320" height="56" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="300" y="460" text-anchor="middle" font-size="13" font-weight="bold" fill="#334155">会话日志 JSONL 落盘</text>
  <text x="300" y="478" text-anchor="middle" font-size="11" fill="#64748b">记录组装后的模型请求与工具调用</text>

  <!-- 侧边注释：复用 session id -->
  <line x1="460" y1="236" x2="520" y2="236" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#sdkArrow)"/>
  <rect x="520" y="196" width="240" height="86" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5" stroke-dasharray="5 3"/>
  <text x="640" y="220" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">复用 session id</text>
  <text x="640" y="238" text-anchor="middle" font-size="10" fill="#7a30b0">保留该会话的 Bash 进程</text>
  <text x="640" y="254" text-anchor="middle" font-size="10" fill="#7a30b0">含工作目录 / 导出变量 / shell 函数</text>
  <text x="640" y="270" text-anchor="middle" font-size="10" fill="#7a30b0">独立任务请用新的 session id</text>

  <!-- 底部警告 -->
  <rect x="170" y="512" width="460" height="40" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="400" y="536" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">danger-full-access：只能在可丢弃的 checkout 或容器内运行</text>
</svg>
