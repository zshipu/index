<svg viewBox="0 0 800 440" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="s19Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="440" rx="12" fill="#f8f9ff"/>

  <text x="400" y="28" text-anchor="middle" font-size="15" font-weight="bold" fill="#334155">LLM 适配器 seam：接入任意模型</text>

  <!-- Consumer：agent-loop -->
  <rect x="240" y="55" width="320" height="80" rx="12" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="400" y="79" text-anchor="middle" font-size="14" font-weight="bold" fill="#8a3a00">Consumer（agent-loop）</text>
  <text x="400" y="99" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">@deepseek-ai/dsh-agent-loop</text>
  <text x="400" y="117" text-anchor="middle" font-size="10.5" fill="#a04000">消费提供方无关的流式生成服务</text>

  <line x1="400" y1="135" x2="400" y2="165" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s19Arrow)"/>
  <text x="412" y="152" font-size="10.5" fill="#64748b">① 提供方无关的 stream()</text>

  <!-- seam：ctx.llm -->
  <rect x="200" y="165" width="400" height="90" rx="12" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="400" y="191" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a3a8a">ctx.llm（LLM 适配器注册表 / seam）</text>
  <text x="400" y="209" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">@deepseek-ai/dsh-llm</text>
  <text x="400" y="227" text-anchor="middle" font-size="10.5" fill="#2a5aa0">LlmAdapter 抽象类 · GenerateOptions → StreamChunk</text>

  <!-- 三个适配器 -->
  <rect x="60" y="310" width="210" height="85" rx="12" fill="#e8f5e9" stroke="#27ae60" stroke-width="2"/>
  <text x="165" y="336" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">MyAdapter</text>
  <text x="165" y="354" text-anchor="middle" font-size="10.5" fill="#2a7a3a">新接入的适配器</text>
  <text x="165" y="371" text-anchor="middle" font-size="10.5" fill="#2a7a3a">提供方路由 ['my-provider']</text>

  <rect x="300" y="310" width="200" height="85" rx="12" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="400" y="336" text-anchor="middle" font-size="13" font-weight="bold" fill="#334155">llm-deepseek</text>
  <text x="400" y="354" text-anchor="middle" font-size="10.5" fill="#64748b">DeepSeek API</text>
  <text x="400" y="371" text-anchor="middle" font-size="10.5" fill="#64748b">OpenAI 兼容格式</text>

  <rect x="530" y="310" width="210" height="85" rx="12" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="635" y="336" text-anchor="middle" font-size="13" font-weight="bold" fill="#334155">llm-pi-ai</text>
  <text x="635" y="354" text-anchor="middle" font-size="10.5" fill="#64748b">Pi AI</text>
  <text x="635" y="371" text-anchor="middle" font-size="10.5" fill="#64748b">不同的 API 格式</text>

  <!-- 路由箭头 -->
  <line x1="240" y1="255" x2="165" y2="310" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s19Arrow)"/>
  <line x1="400" y1="255" x2="400" y2="310" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s19Arrow)"/>
  <line x1="600" y1="255" x2="635" y2="310" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s19Arrow)"/>

  <text x="400" y="420" text-anchor="middle" font-size="11" fill="#64748b">② registerAdapter 把提供方路由绑定到适配器 · GenerateOptions.provider 选择适配器 · model 交给适配器</text>
</svg>
