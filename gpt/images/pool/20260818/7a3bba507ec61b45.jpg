<svg viewBox="0 0 800 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="s17Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="380" rx="12" fill="#f8f9ff"/>

  <text x="400" y="28" text-anchor="middle" font-size="15" font-weight="bold" fill="#334155">能力 Seam 的三角色</text>

  <!-- 完整能力容器 -->
  <rect x="30" y="52" width="740" height="280" rx="14" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="6,4"/>
  <text x="48" y="74" font-size="12" fill="#64748b">完整能力 Seam（任何单一角色都不是 seam）</text>

  <!-- Service Definition -->
  <rect x="60" y="150" width="240" height="104" rx="12" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="180" y="178" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a3a8a">Service Definition</text>
  <text x="180" y="198" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">dsh-shell</text>
  <text x="180" y="220" text-anchor="middle" font-size="10.5" fill="#2a5aa0">定义 ctx.shell 服务</text>
  <text x="180" y="237" text-anchor="middle" font-size="10.5" fill="#2a5aa0">以及 Request / Result 类型</text>

  <!-- Service Provider -->
  <rect x="440" y="80" width="290" height="92" rx="12" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="585" y="106" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a5a2a">Service Provider</text>
  <text x="585" y="126" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">dsh-bash-local</text>
  <text x="585" y="148" text-anchor="middle" font-size="10.5" fill="#2a7a3a">在本地计算机上执行命令</text>
  <text x="585" y="164" text-anchor="middle" font-size="10.5" fill="#2a7a3a">也可替换为 bash-sandbox / pwsh-local</text>

  <!-- Consumer -->
  <rect x="440" y="232" width="290" height="92" rx="12" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="585" y="258" text-anchor="middle" font-size="14" font-weight="bold" fill="#8a3a00">Consumer（面向模型的工具）</text>
  <text x="585" y="278" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">dsh-tool-bash</text>
  <text x="585" y="300" text-anchor="middle" font-size="10.5" fill="#a04000">把能力公开为模型可调用的 bash 工具</text>

  <!-- Provider 依赖 Definition -->
  <line x1="440" y1="118" x2="302" y2="186" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s17Arrow)"/>
  <text x="360" y="130" text-anchor="middle" font-size="10.5" fill="#64748b">继承实现 extends</text>

  <!-- Consumer 依赖 Definition -->
  <line x1="440" y1="262" x2="302" y2="214" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s17Arrow)"/>
  <text x="352" y="262" text-anchor="middle" font-size="10.5" fill="#64748b">依赖 inject: ['shell']</text>

  <text x="400" y="352" text-anchor="middle" font-size="11" fill="#64748b">Provider 与 Consumer 互不依赖；更换提供方时 Definition 与 Consumer 保持不变</text>
</svg>
