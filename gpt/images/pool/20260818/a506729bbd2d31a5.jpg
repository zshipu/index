<svg viewBox="0 0 840 410" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <rect width="840" height="410" rx="12" fill="#f8f9ff"/>

  <text x="420" y="28" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">三种发布途径对比</text>

  <!-- npm 发布 -->
  <rect x="24" y="52" width="248" height="260" rx="12" fill="#f0f7f0" stroke="#27ae60" stroke-width="1.5"/>
  <text x="148" y="80" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">npm 发布</text>
  <text x="148" y="98" text-anchor="middle" font-size="9.5" fill="#2a7a3a">dsh plugin add your-package</text>
  <line x1="40" y1="110" x2="256" y2="110" stroke="#27ae60" stroke-width="1" opacity="0.4"/>
  <text x="40" y="130" font-size="10.5" fill="#334155">pnpm publish 时构建 lib/</text>
  <text x="40" y="150" font-size="10.5" fill="#334155">安装的是预构建代码</text>
  <text x="40" y="170" font-size="10.5" fill="#334155">分发 npm 包，即装即用</text>
  <rect x="44" y="210" width="208" height="36" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="148" y="233" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">零构建授权</text>

  <!-- tarball 交付 -->
  <rect x="296" y="52" width="248" height="260" rx="12" fill="#eef3fc" stroke="#2980b9" stroke-width="1.5"/>
  <text x="420" y="80" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">tarball 交付</text>
  <text x="420" y="98" text-anchor="middle" font-size="9" fill="#2a5aa0">dsh plugin add ./hello-plugin-0.1.0.tgz</text>
  <line x1="312" y1="110" x2="528" y2="110" stroke="#2980b9" stroke-width="1" opacity="0.4"/>
  <text x="312" y="130" font-size="10.5" fill="#334155">pnpm pack 打出 tgz 包</text>
  <text x="312" y="150" font-size="10.5" fill="#334155">可离线文件分发</text>
  <text x="312" y="170" font-size="10.5" fill="#334155">安装到 profile 即用</text>
  <rect x="316" y="210" width="208" height="36" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="420" y="233" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">零构建授权</text>

  <!-- Git 安装 -->
  <rect x="568" y="52" width="248" height="260" rx="12" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="692" y="80" text-anchor="middle" font-size="13" font-weight="bold" fill="#8a3a00">Git 安装</text>
  <text x="692" y="98" text-anchor="middle" font-size="9" fill="#a04000">github:you/hello-plugin#&lt;sha&gt;</text>
  <line x1="584" y1="110" x2="800" y2="110" stroke="#e07b39" stroke-width="1" opacity="0.4"/>
  <text x="584" y="130" font-size="10.5" fill="#334155">拉取源码，非构建产物</text>
  <text x="584" y="150" font-size="10.5" fill="#334155">作者需自包含 prepare 脚本</text>
  <text x="584" y="170" font-size="10.5" fill="#334155">pnpm ≥10 需 allowBuilds 授权</text>
  <rect x="588" y="210" width="208" height="36" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="692" y="233" text-anchor="middle" font-size="11" font-weight="bold" fill="#8a3a00">需构建授权</text>

  <!-- 底部安全提示 -->
  <rect x="24" y="322" width="792" height="60" rx="10" fill="#0d2b52"/>
  <text x="44" y="347" font-size="13" font-weight="bold" fill="#f6c55a">安全提示</text>
  <text x="44" y="367" font-size="10.5" fill="#f0f4ff">只对源码可信的包授权，并锁定 commit sha；授权允许代码在安装时于你机器上执行，且不在 agent 沙箱之内。</text>

  <text x="420" y="400" text-anchor="middle" font-size="10" fill="#64748b">npm 与 tarball 分发预构建产物，Git 拉取源码需要额外构建授权</text>
</svg>
