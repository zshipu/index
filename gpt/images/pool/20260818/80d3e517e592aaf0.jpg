<svg viewBox="0 0 800 620" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="webArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="620" rx="12" fill="#fafbff"/>

  <text x="400" y="32" text-anchor="middle" font-size="16" font-weight="bold" fill="#334155">Web UI 交互流程</text>

  <!-- 主流程（左列） -->
  <!-- 1 启动 -->
  <rect x="80" y="60" width="280" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="220" y="84" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">启动 Web UI</text>
  <text x="220" y="102" text-anchor="middle" font-size="11" fill="#2a5aa0">dsh --profile web</text>
  <line x1="220" y1="116" x2="220" y2="136" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 2 打印地址 -->
  <rect x="80" y="136" width="280" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="220" y="160" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">命令打印访问地址</text>
  <text x="220" y="178" text-anchor="middle" font-size="11" fill="#2a5aa0">浏览器打开 http://127.0.0.1:3080</text>
  <line x1="220" y1="192" x2="220" y2="212" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 3 配置模型 -->
  <rect x="80" y="212" width="280" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="220" y="236" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">设置 → 模型</text>
  <text x="220" y="254" text-anchor="middle" font-size="11" fill="#2a5aa0">填入 DeepSeek 密钥并保存，无需重启</text>
  <line x1="220" y1="268" x2="220" y2="288" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 4 选择工作区 -->
  <rect x="80" y="288" width="280" height="56" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="220" y="312" text-anchor="middle" font-size="13" font-weight="bold" fill="#5b1a8a">选择工作区</text>
  <text x="220" y="330" text-anchor="middle" font-size="11" fill="#7a30b0">添加并选中项目目录，选中前输入框不可用</text>
  <line x1="220" y1="344" x2="220" y2="364" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 5 运行任务 -->
  <rect x="80" y="364" width="280" height="56" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="220" y="388" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a3a8a">运行任务</text>
  <text x="220" y="406" text-anchor="middle" font-size="11" fill="#2a5aa0">启动会话并发送一句提示词</text>
  <line x1="220" y1="420" x2="220" y2="440" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 6 Agent 执行 -->
  <rect x="80" y="440" width="280" height="56" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="2"/>
  <text x="220" y="464" text-anchor="middle" font-size="13" font-weight="bold" fill="#8a3a00">Agent 执行</text>
  <text x="220" y="482" text-anchor="middle" font-size="11" fill="#a04000">读文件 · 跑命令 · 维护计划</text>

  <!-- 7 完成 -->
  <line x1="220" y1="496" x2="220" y2="516" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>
  <rect x="80" y="516" width="280" height="56" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="220" y="540" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">任务完成</text>
  <text x="220" y="558" text-anchor="middle" font-size="11" fill="#2a7a3a">在会话中查看 Agent 的操作与结果</text>

  <!-- 审批分支（右列） -->
  <line x1="360" y1="468" x2="430" y2="468" stroke="#e07b39" stroke-width="1.5" marker-end="url(#webArrow)"/>
  <text x="395" y="456" text-anchor="middle" font-size="10" fill="#c2410c">需审批？</text>

  <rect x="430" y="440" width="290" height="56" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="575" y="464" text-anchor="middle" font-size="13" font-weight="bold" fill="#8a3a00">Web UI 询问审批</text>
  <text x="575" y="482" text-anchor="middle" font-size="11" fill="#a04000">当前权限策略下需要你确认</text>

  <line x1="575" y1="496" x2="575" y2="516" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <rect x="430" y="516" width="290" height="56" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="575" y="540" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">你批准 / 拒绝</text>
  <text x="575" y="558" text-anchor="middle" font-size="11" fill="#2a7a3a">批准后 Agent 继续执行</text>

  <line x1="430" y1="544" x2="360" y2="544" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#webArrow)"/>

  <!-- 图例 -->
  <text x="80" y="600" font-size="11" fill="#64748b">提示：操作无需审批时，Agent 直接从执行一路走到完成。</text>
</svg>
