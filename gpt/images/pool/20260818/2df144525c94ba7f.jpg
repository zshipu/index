<svg viewBox="0 0 940 470" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="tpArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
    <marker id="tpArrowOrange" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#c2410c"/>
    </marker>
  </defs>
  <rect width="940" height="470" rx="12" fill="#fafbff"/>

  <text x="470" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">工具执行流水线：一次工具调用经过的完整环节</text>

  <!-- 入口 -->
  <rect x="375" y="42" width="190" height="46" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="470" y="62" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">模型消息含 tool-call</text>
  <text x="470" y="79" text-anchor="middle" font-size="10" fill="#64748b">同时记录 tool/call 会话事件</text>
  <!-- 入口箭头改为汇入第一步 tools/pre-execute，而非中间的 tools/execute -->
  <path d="M 470 88 L 470 100 L 135 100 L 135 110" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <!-- 第一行 -->
  <rect x="40" y="112" width="190" height="60" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="135" y="134" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">tools/pre-execute</text>
  <text x="135" y="152" text-anchor="middle" font-size="10" fill="#2a5aa0">钩子 · 权限 · 沙箱</text>
  <line x1="230" y1="142" x2="250" y2="142" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="250" y="112" width="170" height="60" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="335" y="134" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">单调守卫</text>
  <text x="335" y="152" text-anchor="middle" font-size="10" fill="#a04000">deny / abstain</text>
  <line x1="420" y1="142" x2="440" y2="142" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="440" y="112" width="190" height="60" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="535" y="134" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">tools/execute</text>
  <text x="535" y="152" text-anchor="middle" font-size="10" fill="#2a5aa0">超时 · 重试 · 指标</text>
  <line x1="630" y1="142" x2="650" y2="142" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="650" y="112" width="190" height="60" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="745" y="134" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">工具 execute() 主体</text>
  <text x="745" y="152" text-anchor="middle" font-size="10" fill="#2a7a3a">返回规范 JSON 值</text>

  <!-- 第一行到第二行的连接：绕开左侧分支走廊，从最左侧空白处下沉，由左边缘进入 post-execute -->
  <path d="M 745 172 L 745 205 L 15 205 L 15 252 L 40 252" fill="none" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <!-- 第二行 -->
  <rect x="40" y="222" width="190" height="60" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="135" y="244" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">tools/post-execute</text>
  <text x="135" y="262" text-anchor="middle" font-size="10" fill="#7a30b0">改写 · 阻止 · 追加上下文</text>
  <line x1="230" y1="252" x2="250" y2="252" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="250" y="222" width="170" height="60" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="335" y="244" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">finalizeContent</text>
  <text x="335" y="262" text-anchor="middle" font-size="10" fill="#64748b">最后内容不变式</text>
  <line x1="420" y1="252" x2="440" y2="252" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="440" y="222" width="190" height="60" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="535" y="244" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">tools/result</text>
  <text x="535" y="262" text-anchor="middle" font-size="10" fill="#a04000">冻结 · 权威结果</text>
  <line x1="630" y1="252" x2="650" y2="252" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#tpArrow)"/>

  <rect x="650" y="222" width="190" height="60" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="745" y="244" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">tool/result 会话事件</text>
  <text x="745" y="262" text-anchor="middle" font-size="10" fill="#2a7a3a">模型可见结果</text>

  <!-- 审批分支（ask）：从 pre-execute 出发，绕开 post-execute 方框（走 230-250 空隙），进入 ctx.approval -->
  <path d="M 135 172 L 135 182 L 235 182 L 235 332 L 135 332 L 135 340"
        fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#tpArrow)"/>
  <text x="140" y="176" font-size="10" fill="#334155">ask</text>

  <rect x="40" y="340" width="190" height="84" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="135" y="362" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">ctx.approval</text>
  <text x="135" y="380" text-anchor="middle" font-size="10" fill="#a04000">一次性询问</text>
  <text x="135" y="396" text-anchor="middle" font-size="10" fill="#a04000">allowed-once 才继续</text>

  <!-- 审批通过后：沿另一条空隙(245)绕回，汇入单调守卫左侧，与主流程同点接续 -->
  <path d="M 230 372 L 245 372 L 245 142 L 250 142"
        fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#tpArrow)"/>
  <text x="248" y="260" font-size="10" fill="#64748b" transform="rotate(-90 248 260)">approved</text>

  <!-- 拒绝分支（deny）：从单调守卫出发，绕开 finalizeContent 方框（走 420-440 空隙），进入拒绝框 -->
  <path d="M 335 172 L 335 190 L 430 190 L 430 325 L 355 325 L 355 340"
        fill="none" stroke="#c2410c" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#tpArrowOrange)"/>
  <text x="340" y="184" font-size="10" fill="#c2410c">deny</text>

  <rect x="270" y="340" width="170" height="60" rx="10" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5"/>
  <text x="355" y="362" text-anchor="middle" font-size="12" font-weight="bold" fill="#991b1b">被拒绝 / 审批未通过</text>
  <text x="355" y="380" text-anchor="middle" font-size="10" fill="#b91c1c">工具主体跳过</text>

  <!-- 图例 -->
  <text x="520" y="366" font-size="10" fill="#64748b">tools/result 之后：UI 卡片 + 工具批次结算</text>
  <text x="520" y="386" font-size="10" fill="#64748b">additionalContexts 在记录结果后注入下一次请求</text>
</svg>
