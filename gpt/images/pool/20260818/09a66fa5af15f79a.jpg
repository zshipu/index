<svg viewBox="0 0 820 300" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p7Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="820" height="300" rx="12" fill="#f8f9ff"/>
  <text x="410" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">patch 覆盖层加载流程</text>

  <rect x="16" y="56" width="210" height="96" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="121" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">终端命令</text>
  <text x="121" y="104" text-anchor="middle" font-size="10" fill="#a04000">pnpm dsh web</text>
  <text x="121" y="120" text-anchor="middle" font-size="9" fill="#a04000">--patch ./scratch-plugin/cordis.yml</text>

  <rect x="250" y="56" width="170" height="96" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="335" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">patch 覆盖层</text>
  <text x="335" y="102" text-anchor="middle" font-size="10" fill="#64748b">scratch-plugin/cordis.yml</text>
  <text x="335" y="119" text-anchor="middle" font-size="10" fill="#64748b">insert: id / name</text>
  <text x="335" y="136" text-anchor="middle" font-size="10" fill="#64748b">只贡献配置</text>

  <rect x="444" y="56" width="176" height="96" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="532" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">dsh 加载器</text>
  <text x="532" y="102" text-anchor="middle" font-size="10" fill="#2a5aa0">profile + patch 叠加</text>
  <text x="532" y="119" text-anchor="middle" font-size="10" fill="#2a5aa0">解析插件绝对路径</text>

  <rect x="644" y="56" width="160" height="96" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="724" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">加载插件</text>
  <text x="724" y="102" text-anchor="middle" font-size="10" fill="#2a7a3a">调用 apply(ctx)</text>
  <text x="724" y="119" text-anchor="middle" font-size="10" fill="#2a7a3a">打印加载日志</text>

  <line x1="226" y1="104" x2="246" y2="104" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p7Arrow)"/>
  <line x1="420" y1="104" x2="440" y2="104" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p7Arrow)"/>
  <line x1="620" y1="104" x2="640" y2="104" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p7Arrow)"/>

  <line x1="724" y1="152" x2="724" y2="190" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4,3" marker-end="url(#p7Arrow)"/>

  <rect x="564" y="194" width="320" height="54" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="724" y="215" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">终端输出</text>
  <text x="724" y="234" text-anchor="middle" font-size="11" fill="#2a7a3a">[hello-plugin] plugin loaded!</text>

  <text x="410" y="282" text-anchor="middle" font-size="10" fill="#64748b">插件路径必须为绝对路径；patch 只贡献配置，不改变 profile 目录</text>
</svg>
