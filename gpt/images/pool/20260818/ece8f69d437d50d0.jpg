<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="f16Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="500" rx="12" fill="#fafbff"/>

  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">五种分发模式</text>

  <!-- ============ emit 广播 ============ -->
  <rect x="26" y="62" width="150" height="44" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="101" y="84" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">emit 广播</text>
  <text x="101" y="99" text-anchor="middle" font-size="9" fill="#2a5aa0">ctx.emit</text>

  <rect x="210" y="62" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="255" y="89" text-anchor="middle" font-size="11" fill="#475569">L1</text>
  <rect x="360" y="62" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="405" y="89" text-anchor="middle" font-size="11" fill="#475569">L2</text>
  <rect x="510" y="62" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="555" y="89" text-anchor="middle" font-size="11" fill="#475569">L3</text>

  <line x1="302" y1="84" x2="357" y2="84" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <line x1="452" y1="84" x2="507" y2="84" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>

  <text x="620" y="80" font-size="10" fill="#475569">同步按注册顺序执行</text>
  <text x="620" y="98" font-size="10" fill="#475569">返回值被忽略</text>

  <!-- ============ bail 短路 ============ -->
  <rect x="26" y="152" width="150" height="44" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="101" y="174" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">bail 短路</text>
  <text x="101" y="189" text-anchor="middle" font-size="9" fill="#a04000">ctx.bail</text>

  <rect x="210" y="152" width="90" height="44" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="2"/>
  <text x="255" y="173" text-anchor="middle" font-size="10" font-weight="bold" fill="#8a3a00">返回 blocked</text>
  <text x="255" y="188" text-anchor="middle" font-size="9" fill="#a04000">第一个有效值胜出</text>

  <rect x="360" y="152" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3" opacity="0.35"/>
  <text x="405" y="179" text-anchor="middle" font-size="11" fill="#475569" opacity="0.35">L2</text>
  <line x1="393" y1="162" x2="417" y2="186" stroke="#e07b39" stroke-width="1.5"/>
  <line x1="417" y1="162" x2="393" y2="186" stroke="#e07b39" stroke-width="1.5"/>

  <rect x="510" y="152" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3" opacity="0.35"/>
  <text x="555" y="179" text-anchor="middle" font-size="11" fill="#475569" opacity="0.35">L3</text>
  <line x1="543" y1="162" x2="567" y2="186" stroke="#e07b39" stroke-width="1.5"/>
  <line x1="567" y1="162" x2="543" y2="186" stroke="#e07b39" stroke-width="1.5"/>

  <text x="620" y="170" font-size="10" fill="#475569">第一个非 null / false / undefined</text>
  <text x="620" y="188" font-size="10" fill="#475569">返回值成为最终结果，后续停止</text>

  <!-- ============ serial 顺序 ============ -->
  <rect x="26" y="242" width="150" height="44" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="101" y="264" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">serial 顺序</text>
  <text x="101" y="279" text-anchor="middle" font-size="9" fill="#2a7a3a">ctx.serial</text>

  <rect x="210" y="242" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="255" y="269" text-anchor="middle" font-size="11" fill="#475569">L1</text>
  <rect x="360" y="242" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="405" y="269" text-anchor="middle" font-size="11" fill="#475569">L2</text>
  <rect x="510" y="242" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="555" y="269" text-anchor="middle" font-size="11" fill="#475569">L3</text>

  <line x1="302" y1="264" x2="357" y2="264" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="330" y="258" text-anchor="middle" font-size="8" fill="#64748b">await</text>
  <line x1="452" y1="264" x2="507" y2="264" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="480" y="258" text-anchor="middle" font-size="8" fill="#64748b">await</text>

  <text x="620" y="260" font-size="10" fill="#475569">按注册顺序依次执行</text>
  <text x="620" y="278" font-size="10" fill="#475569">并等待每个异步结果</text>

  <!-- ============ waterfall 流水线 ============ -->
  <rect x="26" y="332" width="150" height="44" rx="8" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="101" y="354" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">waterfall 流水线</text>
  <text x="101" y="369" text-anchor="middle" font-size="9" fill="#7a30b0">ctx.waterfall</text>

  <rect x="210" y="332" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="255" y="359" text-anchor="middle" font-size="11" fill="#475569">L1</text>
  <rect x="360" y="332" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="405" y="359" text-anchor="middle" font-size="11" fill="#475569">L2</text>
  <rect x="510" y="332" width="90" height="44" rx="8" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="555" y="359" text-anchor="middle" font-size="11" fill="#475569">L3</text>

  <line x1="302" y1="326" x2="357" y2="326" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="330" y="320" text-anchor="middle" font-size="8" fill="#7a30b0">next()</text>
  <line x1="452" y1="326" x2="507" y2="326" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="480" y="320" text-anchor="middle" font-size="8" fill="#7a30b0">next()</text>

  <line x1="507" y1="384" x2="363" y2="384" stroke="#e07b39" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="435" y="378" text-anchor="middle" font-size="8" fill="#c2410c">返回值</text>
  <line x1="357" y1="384" x2="213" y2="384" stroke="#e07b39" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <text x="285" y="378" text-anchor="middle" font-size="8" fill="#c2410c">返回值</text>

  <text x="620" y="348" font-size="10" fill="#475569">每个监听器调用 next() 传递下游</text>
  <text x="620" y="366" font-size="10" fill="#475569">不调用 next() 即短路流水线</text>

  <!-- ============ parallel 并行 ============ -->
  <rect x="26" y="422" width="150" height="44" rx="8" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="101" y="444" text-anchor="middle" font-size="12" font-weight="bold" fill="#475569">parallel 并行</text>
  <text x="101" y="459" text-anchor="middle" font-size="9" fill="#64748b">ctx.parallel</text>

  <rect x="330" y="426" width="180" height="22" rx="6" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="420" y="441" text-anchor="middle" font-size="10" fill="#475569">L1</text>
  <rect x="330" y="450" width="180" height="22" rx="6" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="420" y="465" text-anchor="middle" font-size="10" fill="#475569">L2</text>
  <rect x="330" y="474" width="180" height="22" rx="6" fill="#ffffff" stroke="#94a3b8" stroke-width="1.3"/>
  <text x="420" y="489" text-anchor="middle" font-size="10" fill="#475569">L3</text>

  <line x1="240" y1="444" x2="327" y2="437" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <line x1="240" y1="444" x2="327" y2="461" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>
  <line x1="240" y1="444" x2="327" y2="485" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f16Arrow)"/>

  <text x="620" y="442" font-size="10" fill="#475569">所有监听器并行执行</text>
  <text x="620" y="460" font-size="10" fill="#475569">await 全部完成，无返回值</text>
</svg>
