<svg viewBox="0 0 800 300" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="f12Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="300" rx="12" fill="#fafbff"/>

  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">Fiber 状态机</text>

  <!-- 主路径状态 -->
  <rect x="20" y="80" width="130" height="64" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="85" y="105" text-anchor="middle" font-size="12" font-weight="bold" fill="#475569">PENDING</text>
  <text x="85" y="123" text-anchor="middle" font-size="10" fill="#64748b">依赖未就绪</text>

  <line x1="150" y1="112" x2="181" y2="112" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f12Arrow)"/>
  <text x="166" y="100" text-anchor="middle" font-size="9" fill="#64748b">依赖就绪</text>

  <rect x="185" y="80" width="130" height="64" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="250" y="105" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">LOADING</text>
  <text x="250" y="123" text-anchor="middle" font-size="10" fill="#2a5aa0">正在执行 apply</text>

  <line x1="315" y1="112" x2="346" y2="112" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f12Arrow)"/>
  <text x="331" y="100" text-anchor="middle" font-size="9" fill="#64748b">apply 完成</text>

  <rect x="350" y="80" width="130" height="64" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="415" y="105" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">ACTIVE</text>
  <text x="415" y="123" text-anchor="middle" font-size="10" fill="#2a7a3a">插件运行中</text>

  <line x1="480" y1="112" x2="511" y2="112" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f12Arrow)"/>
  <text x="496" y="100" text-anchor="middle" font-size="9" fill="#64748b">开始卸载</text>

  <rect x="515" y="80" width="130" height="64" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="580" y="105" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">UNLOADING</text>
  <text x="580" y="123" text-anchor="middle" font-size="10" fill="#7a30b0">释放资源</text>

  <line x1="645" y1="112" x2="676" y2="112" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f12Arrow)"/>
  <text x="661" y="100" text-anchor="middle" font-size="9" fill="#64748b">清理完成</text>

  <rect x="680" y="80" width="100" height="64" rx="10" fill="#f1f5f9" stroke="#64748b" stroke-width="1.5"/>
  <text x="730" y="105" text-anchor="middle" font-size="12" font-weight="bold" fill="#475569">DISPOSED</text>
  <text x="730" y="123" text-anchor="middle" font-size="10" fill="#64748b">已完全卸载</text>

  <!-- FAILED 分支 -->
  <line x1="250" y1="144" x2="250" y2="194" stroke="#e07b39" stroke-width="1.5" marker-end="url(#f12Arrow)"/>
  <text x="260" y="174" font-size="9" fill="#c2410c">apply 抛异常</text>

  <rect x="185" y="198" width="130" height="64" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="250" y="223" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">FAILED</text>
  <text x="250" y="241" text-anchor="middle" font-size="10" fill="#a04000">加载失败</text>
</svg>
