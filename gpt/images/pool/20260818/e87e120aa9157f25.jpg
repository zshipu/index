<svg viewBox="0 0 900 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="s18Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="900" height="400" rx="12" fill="#f8f9ff"/>

  <text x="450" y="28" text-anchor="middle" font-size="15" font-weight="bold" fill="#334155">myCap 三角色结构与数据流</text>

  <!-- 请求方向标注（在方框上方） -->
  <text x="155" y="120" text-anchor="middle" font-size="11" fill="#334155">① 模型调用 my_cap 工具</text>
  <text x="405" y="120" text-anchor="middle" font-size="11" fill="#334155">② ctx.myCap.execute(request)</text>
  <text x="665" y="120" text-anchor="middle" font-size="11" fill="#334155">③ 委托给实现类</text>

  <!-- 模型 -->
  <rect x="20" y="130" width="110" height="110" rx="12" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="75" y="162" text-anchor="middle" font-size="14" font-weight="bold" fill="#5b1a8a">模型（LLM）</text>
  <text x="75" y="184" text-anchor="middle" font-size="10.5" fill="#7a30b0">调用 my_cap</text>
  <text x="75" y="200" text-anchor="middle" font-size="10.5" fill="#7a30b0">等待工具结果</text>

  <line x1="130" y1="185" x2="180" y2="185" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s18Arrow)"/>

  <!-- Consumer -->
  <rect x="180" y="130" width="200" height="110" rx="12" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="280" y="162" text-anchor="middle" font-size="14" font-weight="bold" fill="#8a3a00">Consumer（工具）</text>
  <text x="280" y="180" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">tool-my-cap</text>
  <text x="280" y="198" text-anchor="middle" font-size="10.5" fill="#a04000">defineTool my_cap</text>
  <text x="280" y="215" text-anchor="middle" font-size="10.5" fill="#a04000">inject: ['tools', 'myCap']</text>

  <line x1="380" y1="185" x2="430" y2="185" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s18Arrow)"/>

  <!-- Service Definition -->
  <rect x="430" y="130" width="210" height="110" rx="12" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="535" y="162" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a3a8a">Service Definition</text>
  <text x="535" y="180" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">dsh-my-cap</text>
  <text x="535" y="198" text-anchor="middle" font-size="10.5" fill="#2a5aa0">abstract MyCapService</text>
  <text x="535" y="215" text-anchor="middle" font-size="10.5" fill="#2a5aa0">execute(request) → MyCapResult</text>
  <text x="535" y="231" text-anchor="middle" font-size="10" fill="#2a5aa0">拥有 MyCapRequest / MyCapResult</text>

  <line x1="640" y1="185" x2="690" y2="185" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#s18Arrow)"/>

  <!-- Service Provider -->
  <rect x="690" y="130" width="180" height="110" rx="12" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="780" y="162" text-anchor="middle" font-size="14" font-weight="bold" fill="#1a5a2a">Service Provider</text>
  <text x="780" y="180" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">my-cap-local</text>
  <text x="780" y="198" text-anchor="middle" font-size="10.5" fill="#2a7a3a">class MyCapLocal</text>
  <text x="780" y="215" text-anchor="middle" font-size="10.5" fill="#2a7a3a">input.toUpperCase()</text>

  <!-- 返回路径（虚线） -->
  <path d="M 780 240 L 780 320 L 75 320 L 75 242" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5,4" marker-end="url(#s18Arrow)"/>
  <text x="450" y="312" text-anchor="middle" font-size="11" fill="#c2410c">④ 返回 { output }（Consumer 渲染为文本，作为工具结果交给模型）</text>
  <text x="450" y="352" text-anchor="middle" font-size="11" fill="#334155">示例：input: 'hello runoob' → output: 'HELLO RUNOOB'</text>
</svg>
