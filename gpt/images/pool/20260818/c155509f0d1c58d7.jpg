<svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p6Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="400" rx="12" fill="#f8f9ff"/>
  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">插件结构与加载示意</text>

  <rect x="40" y="44" width="290" height="244" rx="10" fill="#eef1f6" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="185" y="68" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">插件文件：my-plugin.ts</text>
  <text x="185" y="85" text-anchor="middle" font-size="10" fill="#64748b">一个导出 apply 的 TS 模块</text>

  <rect x="54" y="96" width="262" height="52" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.2"/>
  <text x="66" y="116" font-size="11" font-weight="bold" fill="#1a5a2a">函数形式</text>
  <text x="66" y="135" font-size="10" fill="#2a7a3a">export function apply(ctx)</text>

  <rect x="54" y="160" width="262" height="52" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.2"/>
  <text x="66" y="180" font-size="11" font-weight="bold" fill="#1a3a8a">对象形式</text>
  <text x="66" y="199" font-size="10" fill="#2a5aa0">export default { name, inject, apply }</text>

  <rect x="54" y="224" width="262" height="52" rx="8" fill="#f5effe" stroke="#8e44ad" stroke-width="1.2"/>
  <text x="66" y="244" font-size="11" font-weight="bold" fill="#5b1a8a">类形式</text>
  <text x="66" y="263" font-size="10" fill="#7a30b0">export default class extends Service</text>

  <line x1="330" y1="166" x2="388" y2="166" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p6Arrow)"/>

  <rect x="392" y="124" width="368" height="84" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="576" y="150" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">框架加载插件</text>
  <text x="576" y="171" text-anchor="middle" font-size="11" fill="#a04000">调用 apply(ctx)</text>
  <text x="576" y="190" text-anchor="middle" font-size="10" fill="#a04000">传入上下文对象 ctx</text>

  <line x1="576" y1="208" x2="576" y2="240" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p6Arrow)"/>

  <rect x="392" y="244" width="368" height="112" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="576" y="268" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">ctx 上下文对象：注册能力</text>
  <text x="576" y="292" text-anchor="middle" font-size="11" fill="#2a7a3a">ctx.on(event, handler) 事件监听</text>
  <text x="576" y="312" text-anchor="middle" font-size="11" fill="#2a7a3a">ctx.tools.register(tool) 工具注册</text>
  <text x="576" y="332" text-anchor="middle" font-size="11" fill="#2a7a3a">ctx.effect(() =&gt; disposer) 手动资源</text>

  <text x="400" y="384" text-anchor="middle" font-size="10" fill="#64748b">函数形式足够大多数场景；需向其他插件提供服务时，用类形式（Service 子类）</text>
</svg>
