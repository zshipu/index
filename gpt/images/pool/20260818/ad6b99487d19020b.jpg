<svg viewBox="0 0 940 460" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="saArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="940" height="460" rx="12" fill="#fafbff"/>

  <text x="470" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">沙箱决策 + 审批流程：让 Agent 的危险动作可控</text>

  <!-- 左栏标题 -->
  <text x="135" y="56" text-anchor="middle" font-size="13" font-weight="bold" fill="#1a5a2a">进程沙箱 ctx.sandbox</text>
  <rect x="30" y="66" width="210" height="42" rx="8" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="135" y="84" text-anchor="middle" font-size="11" fill="#334155">消费方交出确切 argv</text>
  <text x="135" y="99" text-anchor="middle" font-size="10" fill="#64748b">如 ['bash', '-c', 'cmd']，非 shell 字符串</text>
  <line x1="135" y1="108" x2="135" y2="124" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="30" y="126" width="210" height="42" rx="8" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="135" y="144" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">confine(argv, policy)</text>
  <text x="135" y="159" text-anchor="middle" font-size="10" fill="#2a7a3a">策略逐调用携带</text>
  <line x1="135" y1="168" x2="135" y2="184" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="30" y="186" width="210" height="56" rx="8" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="135" y="204" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">后端按策略包装</text>
  <text x="135" y="220" text-anchor="middle" font-size="10" fill="#2a7a3a">bwrap / Landlock / Seatbelt / ACL</text>
  <text x="135" y="234" text-anchor="middle" font-size="10" fill="#2a7a3a">只管控文件系统效果</text>
  <line x1="135" y1="242" x2="135" y2="258" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="30" y="260" width="210" height="56" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="135" y="278" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">返回 ConfinedArgv</text>
  <text x="135" y="294" text-anchor="middle" font-size="10" fill="#2a5aa0">enforcement: full 强制全部</text>
  <text x="135" y="308" text-anchor="middle" font-size="10" fill="#2a5aa0">partial 仅子集（旧 Landlock ABI）</text>
  <line x1="135" y1="316" x2="135" y2="332" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="30" y="334" width="210" height="42" rx="8" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5"/>
  <text x="135" y="352" text-anchor="middle" font-size="11" font-weight="bold" fill="#991b1b">无后端则故障关闭</text>
  <text x="135" y="367" text-anchor="middle" font-size="10" fill="#b91c1c">SANDBOX_UNAVAILABLE</text>

  <text x="135" y="406" text-anchor="middle" font-size="10" fill="#64748b">sandboxMode：read-only / workspace-write / danger-full-access</text>
  <text x="135" y="422" text-anchor="middle" font-size="10" fill="#64748b">会话事件 &gt; 部署默认；danger-full-access 直接 spawn 原始 argv</text>

  <!-- 右栏标题 -->
  <text x="635" y="56" text-anchor="middle" font-size="13" font-weight="bold" fill="#8a3a00">用户审批 ctx.approval</text>
  <rect x="470" y="66" width="330" height="42" rx="8" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="635" y="84" text-anchor="middle" font-size="11" fill="#334155">tools/pre-execute 返回 ask</text>
  <text x="635" y="99" text-anchor="middle" font-size="10" fill="#64748b">携带 agent、toolName、callId、reason</text>
  <line x1="635" y1="108" x2="635" y2="124" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="470" y="126" width="330" height="42" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="635" y="144" text-anchor="middle" font-size="11" font-weight="bold" fill="#8a3a00">approval/request waterfall</text>
  <text x="635" y="159" text-anchor="middle" font-size="10" fill="#a04000">应答者返回结果，或调用 next() 委托</text>
  <line x1="635" y1="168" x2="635" y2="184" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="470" y="186" width="330" height="56" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="635" y="204" text-anchor="middle" font-size="11" font-weight="bold" fill="#8a3a00">一次性决策 ApprovalOutcome</text>
  <text x="635" y="220" text-anchor="middle" font-size="10" fill="#a04000">allowed-once 唯一放行结果</text>
  <text x="635" y="234" text-anchor="middle" font-size="10" fill="#a04000">rejected / cancelled / unavailable 均拒绝</text>
  <line x1="635" y1="242" x2="635" y2="258" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="470" y="260" width="330" height="42" rx="8" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5"/>
  <text x="635" y="278" text-anchor="middle" font-size="11" font-weight="bold" fill="#991b1b">无应答者 / 抛异常 / 违规返回值</text>
  <text x="635" y="293" text-anchor="middle" font-size="10" fill="#b91c1c">一律收敛为 unavailable（故障关闭）</text>
  <line x1="635" y1="302" x2="635" y2="318" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#saArrow)"/>

  <rect x="470" y="320" width="330" height="56" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="635" y="338" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">按会话策略 ApprovalPolicy</text>
  <text x="635" y="354" text-anchor="middle" font-size="10" fill="#2a5aa0">ask（默认）：委托应答者链</text>
  <text x="635" y="368" text-anchor="middle" font-size="10" fill="#2a5aa0">never：确定性 rejected，不分发</text>

  <text x="635" y="406" text-anchor="middle" font-size="10" fill="#64748b">权限预设把两个 knob 捆绑成具名预设</text>
  <text x="635" y="422" text-anchor="middle" font-size="10" fill="#64748b">workspace-write（+ask）与 danger-full-access（+never）</text>
</svg>
