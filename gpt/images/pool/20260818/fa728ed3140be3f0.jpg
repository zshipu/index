<svg viewBox="0 0 800 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="f15Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="380" rx="12" fill="#fafbff"/>

  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">服务隔离：两个插件组各自持有独立实例</text>

  <!-- 全局注册 -->
  <rect x="40" y="44" width="720" height="40" rx="10" fill="#eef2f7" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="400" y="69" text-anchor="middle" font-size="11" font-weight="bold" fill="#475569">全局注册：工具、提示词段、监听器（对所有组 / 所有 agent 可见）</text>

  <!-- group-a 容器 -->
  <rect x="40" y="110" width="345" height="185" rx="12" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5" stroke-dasharray="6,4"/>
  <text x="60" y="134" font-size="12" font-weight="bold" fill="#1a3a8a">group-a（isolate: shell）</text>

  <rect x="65" y="150" width="295" height="48" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="212" y="172" text-anchor="middle" font-size="11" font-weight="bold" fill="#8a3a00">Bash 实例</text>
  <text x="212" y="189" text-anchor="middle" font-size="10" fill="#a04000">timeoutMs: 5000</text>

  <rect x="65" y="225" width="295" height="48" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="212" y="247" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">plugin-a</text>
  <text x="212" y="264" text-anchor="middle" font-size="10" fill="#2a7a3a">注入 ctx.shell</text>

  <line x1="212" y1="225" x2="212" y2="202" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f15Arrow)"/>

  <!-- group-b 容器 -->
  <rect x="415" y="110" width="345" height="185" rx="12" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5" stroke-dasharray="6,4"/>
  <text x="435" y="134" font-size="12" font-weight="bold" fill="#5b1a8a">group-b（isolate: shell）</text>

  <rect x="440" y="150" width="295" height="48" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="587" y="172" text-anchor="middle" font-size="11" font-weight="bold" fill="#8a3a00">Bash 实例</text>
  <text x="587" y="189" text-anchor="middle" font-size="10" fill="#a04000">timeoutMs: 60000</text>

  <rect x="440" y="225" width="295" height="48" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="587" y="247" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">plugin-b</text>
  <text x="587" y="264" text-anchor="middle" font-size="10" fill="#2a7a3a">注入 ctx.shell</text>

  <line x1="587" y1="225" x2="587" y2="202" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#f15Arrow)"/>

  <!-- 底部说明 -->
  <text x="40" y="322" font-size="10" fill="#64748b">shadowing：最具体者胜出——带作用域的工具 / 片段 / 变量仅在自身 scope 内替换全局同名项</text>
  <text x="40" y="342" font-size="10" fill="#64748b">restriction：tools.restrict 为单个 scope 过滤全局工具集合，被过滤掉的工具不可见也不可执行</text>
  <text x="40" y="362" font-size="10" fill="#64748b">scope 按 agent 划分，agent.ctx 上的注册既具有 scope 可见性，生命周期也绑定该 scope</text>
</svg>
