<svg viewBox="0 0 800 320" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p9Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="800" height="320" rx="12" fill="#f8f9ff"/>
  <text x="400" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">依赖就绪后再加载插件</text>

  <rect x="20" y="56" width="172" height="92" rx="10" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="106" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#334155">插件声明依赖</text>
  <text x="106" y="104" text-anchor="middle" font-size="11" fill="#64748b">inject: ['tools']</text>
  <text x="106" y="124" text-anchor="middle" font-size="10" fill="#64748b">需要 tools 服务</text>

  <rect x="230" y="56" width="172" height="92" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="316" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">服务未就绪</text>
  <text x="316" y="104" text-anchor="middle" font-size="11" fill="#a04000">状态 PENDING</text>
  <text x="316" y="124" text-anchor="middle" font-size="10" fill="#a04000">插件等待，不执行</text>

  <rect x="440" y="56" width="172" height="92" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="526" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">服务就绪</text>
  <text x="526" y="104" text-anchor="middle" font-size="11" fill="#2a5aa0">状态 LOADING</text>
  <text x="526" y="124" text-anchor="middle" font-size="10" fill="#2a5aa0">执行 apply(ctx)</text>

  <rect x="650" y="56" width="130" height="92" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="715" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">ACTIVE</text>
  <text x="715" y="104" text-anchor="middle" font-size="10" fill="#2a7a3a">ctx.tools</text>
  <text x="715" y="122" text-anchor="middle" font-size="10" fill="#2a7a3a">已可用</text>

  <line x1="192" y1="102" x2="226" y2="102" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p9Arrow)"/>
  <line x1="402" y1="102" x2="436" y2="102" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p9Arrow)"/>
  <line x1="612" y1="102" x2="646" y2="102" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p9Arrow)"/>

  <text x="419" y="46" text-anchor="middle" font-size="10" fill="#c2410c">tools 服务就绪</text>

  <rect x="160" y="192" width="480" height="58" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="400" y="215" text-anchor="middle" font-size="11" font-weight="bold" fill="#5b1a8a">运行期间服务消失</text>
  <text x="400" y="236" text-anchor="middle" font-size="10" fill="#7a30b0">插件自动卸载（dispose）；服务恢复后自动重新加载</text>

  <text x="400" y="292" text-anchor="middle" font-size="10" fill="#64748b">框架保证：apply 执行时，inject 声明的服务已全部就绪</text>
</svg>
