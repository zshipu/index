<svg viewBox="0 0 860 360" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="p10Arrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="860" height="360" rx="12" fill="#f8f9ff"/>
  <text x="430" y="26" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">工具生命周期：注册 → 组装 → 执行 → 结果</text>

  <rect x="16" y="56" width="196" height="80" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <circle cx="28" cy="68" r="10" fill="#27ae60"/>
  <text x="28" y="72" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">1</text>
  <text x="122" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">注册工具</text>
  <text x="122" y="101" text-anchor="middle" font-size="10" fill="#2a7a3a">ctx.tools.register</text>
  <text x="122" y="119" text-anchor="middle" font-size="9" fill="#2a7a3a">defineTool({...})</text>

  <rect x="236" y="56" width="176" height="80" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <circle cx="248" cy="68" r="10" fill="#2980b9"/>
  <text x="248" y="72" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">2</text>
  <text x="324" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">工具注册表</text>
  <text x="324" y="101" text-anchor="middle" font-size="10" fill="#2a5aa0">ctx.tools 服务</text>

  <rect x="436" y="56" width="196" height="80" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <circle cx="448" cy="68" r="10" fill="#2980b9"/>
  <text x="448" y="72" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">3</text>
  <text x="534" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">提示词组装</text>
  <text x="534" y="101" text-anchor="middle" font-size="10" fill="#2a5aa0">schema 自动流入</text>
  <text x="534" y="119" text-anchor="middle" font-size="9" fill="#2a5aa0">name / description / parameters / output</text>

  <rect x="656" y="56" width="188" height="80" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <circle cx="668" cy="68" r="10" fill="#e07b39"/>
  <text x="668" y="72" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">4</text>
  <text x="750" y="80" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">模型调用</text>
  <text x="750" y="101" text-anchor="middle" font-size="10" fill="#a04000">greet({ name: 'Ada' })</text>

  <line x1="212" y1="96" x2="232" y2="96" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>
  <line x1="412" y1="96" x2="432" y2="96" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>
  <line x1="632" y1="96" x2="652" y2="96" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>

  <line x1="750" y1="136" x2="750" y2="176" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>

  <rect x="656" y="180" width="188" height="84" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <circle cx="668" cy="192" r="10" fill="#e07b39"/>
  <text x="668" y="196" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">5</text>
  <text x="750" y="204" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">execute 执行</text>
  <text x="750" y="225" text-anchor="middle" font-size="10" fill="#a04000">返回规范值</text>
  <text x="750" y="243" text-anchor="middle" font-size="10" fill="#a04000">Hello, Ada!</text>

  <rect x="436" y="180" width="196" height="84" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <circle cx="448" cy="192" r="10" fill="#8e44ad"/>
  <text x="448" y="196" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">6</text>
  <text x="534" y="204" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">output.render</text>
  <text x="534" y="225" text-anchor="middle" font-size="10" fill="#7a30b0">规范值 → 面向模型的内容</text>

  <rect x="236" y="180" width="176" height="84" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <circle cx="248" cy="192" r="10" fill="#27ae60"/>
  <text x="248" y="196" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">7</text>
  <text x="324" y="204" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">模型收到结果</text>
  <text x="324" y="225" text-anchor="middle" font-size="10" fill="#2a7a3a">继续生成后续内容</text>

  <line x1="656" y1="222" x2="634" y2="222" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>
  <line x1="436" y1="222" x2="414" y2="222" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#p10Arrow)"/>

  <text x="430" y="312" text-anchor="middle" font-size="10" fill="#64748b">defineTool 根据 parameters 推导并校验 args；schema 自动流入提示词，模型可直接调用</text>
  <text x="430" y="332" text-anchor="middle" font-size="10" fill="#64748b">execute 返回 output.schema 声明的规范值，output.render 再转成面向模型的内容</text>
</svg>
