<svg viewBox="0 0 860 420" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="bapArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#94a3b8"/>
    </marker>
  </defs>
  <rect width="860" height="420" rx="12" fill="#f8f9ff"/>

  <text x="430" y="28" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">bundle 与 profile：两个概念，两种 manifest</text>

  <!-- ======== 左侧：组合包 bundle ======== -->
  <rect x="24" y="52" width="376" height="250" rx="12" fill="#f0f7f0" stroke="#27ae60" stroke-width="1.5"/>
  <text x="44" y="76" font-size="13" font-weight="bold" fill="#1a5a2a">组合包 bundle</text>
  <text x="44" y="93" font-size="10.5" fill="#2a7a3a">manifest 声明 dsh.bundle · 你编写并分发</text>

  <rect x="40" y="110" width="170" height="46" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="125" y="130" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">package.json</text>
  <text x="125" y="146" text-anchor="middle" font-size="10" fill="#2a7a3a">dsh.bundle.patch 指向</text>

  <rect x="218" y="110" width="174" height="46" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="305" y="130" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">cordis.patch.yml</text>
  <text x="305" y="146" text-anchor="middle" font-size="10" fill="#2a7a3a">插入 / 覆盖插件行</text>

  <rect x="40" y="166" width="352" height="40" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="216" y="184" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a5a2a">index.js</text>
  <text x="216" y="197" text-anchor="middle" font-size="10" fill="#2a7a3a">patch 行按包名引用的插件入口</text>

  <text x="44" y="232" font-size="11" fill="#1a5a2a">回答：这个包贡献什么 —— 一个 patch 文件</text>

  <!-- ======== 右侧：profile ======== -->
  <rect x="460" y="52" width="376" height="250" rx="12" fill="#eef3fc" stroke="#2980b9" stroke-width="1.5"/>
  <text x="480" y="76" font-size="13" font-weight="bold" fill="#1a3a8a">profile</text>
  <text x="480" y="93" font-size="10.5" fill="#2a5aa0">manifest 声明 dsh.profile · 用户用 dsh --profile 启动</text>
  <text x="480" y="108" font-size="10.5" fill="#2a5aa0">位于 $DSH_HOME/profiles/&lt;name&gt;</text>

  <rect x="476" y="122" width="170" height="46" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="561" y="142" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">package.json</text>
  <text x="561" y="158" text-anchor="middle" font-size="10" fill="#2a5aa0">dsh.profile.bundles 有序列表</text>

  <rect x="654" y="122" width="174" height="46" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="741" y="142" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">cordis.patch.yml</text>
  <text x="741" y="158" text-anchor="middle" font-size="10" fill="#2a5aa0">用户自己的 patch 层</text>

  <rect x="476" y="178" width="352" height="40" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="652" y="198" text-anchor="middle" font-size="11" fill="#1a3a8a">由 dsh plugin 自动创建与维护，无需手写</text>

  <text x="480" y="244" font-size="11" fill="#1a3a8a">回答：这套配置由哪些 bundle 按什么顺序组成</text>

  <!-- ======== 关系箭头：profile 的 bundles 引用组合包 ======== -->
  <line x1="460" y1="145" x2="402" y2="145" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#bapArrow)"/>
  <rect x="378" y="113" width="106" height="18" rx="9" fill="#ffffff" opacity="0.92"/>
  <text x="431" y="126" text-anchor="middle" font-size="10" fill="#64748b">bundles 列表按名引用</text>

  <!-- ======== 底部：运行中的插件树 ======== -->
  <line x1="212" y1="302" x2="212" y2="322" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#bapArrow)"/>
  <text x="222" y="316" font-size="10" fill="#64748b">patch 被应用</text>
  <line x1="648" y1="302" x2="648" y2="322" stroke="#94a3b8" stroke-width="1.5" marker-end="url(#bapArrow)"/>
  <text x="658" y="316" font-size="10" fill="#64748b">组装</text>

  <rect x="180" y="322" width="500" height="52" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="430" y="345" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">运行中的插件树（可启动组合）</text>
  <text x="430" y="362" text-anchor="middle" font-size="10.5" fill="#7a30b0">dsh-base + 各已安装 bundle 的插件行</text>

  <text x="430" y="398" text-anchor="middle" font-size="10" fill="#64748b">profile 的 bundles 按序叠加，每个 bundle 的 patch 贡献一批插件行</text>
</svg>
