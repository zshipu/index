    <item>
      <title>谷歌Gemini Live语音启动深度研究，移动多任务处理更便捷</title>
      <link>https://index.zshipu.com/gpt/post/20260819/%E8%B0%B7%E6%AD%8CGemini-Live%E8%AF%AD%E9%9F%B3%E5%90%AF%E5%8A%A8%E6%B7%B1%E5%BA%A6%E7%A0%94%E7%A9%B6%E7%A7%BB%E5%8A%A8%E5%A4%9A%E4%BB%BB%E5%8A%A1%E5%A4%84%E7%90%86%E6%9B%B4%E4%BE%BF%E6%8D%B7/</link>
