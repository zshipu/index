      <title>Anthropic拟允许客户自存数据，企业AI安全策略转向</title>
      <link>https://index.zshipu.com/gpt/post/20260821/Anthropic%E6%8B%9F%E5%85%81%E8%AE%B8%E5%AE%A2%E6%88%B7%E8%87%AA%E5%AD%98%E6%95%B0%E6%8D%AE%E4%BC%81%E4%B8%9AAI%E5%AE%89%E5%85%A8%E7%AD%96%E7%95%A5%E8%BD%AC%E5%90%91/</link>
