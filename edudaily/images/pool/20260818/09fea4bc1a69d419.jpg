<svg viewBox="0 0 940 600" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif;">
  <defs>
    <marker id="stArrow" markerWidth="9" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L0,8 L9,4 z" fill="#475569"/>
    </marker>
  </defs>
  <rect width="940" height="600" rx="12" fill="#fafbff"/>

  <text x="470" y="24" text-anchor="middle" font-size="14" font-weight="bold" fill="#334155">一个轮次（turn）的完整生命周期</text>

  <!-- 参与者头部 -->
  <rect x="28" y="38" width="64" height="34" rx="8" fill="#f0f4ff" stroke="#94a3b8" stroke-width="1.5"/>
  <text x="60" y="59" text-anchor="middle" font-size="11" fill="#334155">用户</text>
  <rect x="148" y="38" width="64" height="34" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="180" y="59" text-anchor="middle" font-size="11" font-weight="bold" fill="#1a3a8a">驱动器</text>
  <rect x="278" y="38" width="64" height="34" rx="8" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5"/>
  <text x="310" y="59" text-anchor="middle" font-size="11" fill="#5b1a8a">钩子</text>
  <rect x="408" y="38" width="64" height="34" rx="8" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5"/>
  <text x="440" y="59" text-anchor="middle" font-size="11" fill="#8a3a00">模型</text>
  <rect x="538" y="38" width="64" height="34" rx="8" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5"/>
  <text x="570" y="59" text-anchor="middle" font-size="11" fill="#1a5a2a">工具</text>
  <rect x="668" y="38" width="64" height="34" rx="8" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5"/>
  <text x="700" y="59" text-anchor="middle" font-size="11" fill="#1a3a8a">会话日志</text>
  <rect x="800" y="38" width="64" height="34" rx="8" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5"/>
  <text x="832" y="59" text-anchor="middle" font-size="11" fill="#1a5a2a">UI/SDK</text>

  <!-- 生命线 -->
  <line x1="60" y1="72" x2="60" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="180" y1="72" x2="180" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="310" y1="72" x2="310" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="440" y1="72" x2="440" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="570" y1="72" x2="570" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="700" y1="72" x2="700" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
  <line x1="832" y1="72" x2="832" y2="570" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>

  <!-- 消息 1 -->
  <line x1="60" y1="82" x2="180" y2="82" stroke="#475569" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="120" y="76" text-anchor="middle" font-size="10" fill="#475569">followup(content)</text>

  <!-- 消息 2 -->
  <line x1="180" y1="98" x2="832" y2="98" stroke="#475569" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="506" y="92" text-anchor="middle" font-size="10" fill="#475569">agent/inbox/inserted { message }</text>

  <!-- 消息 3 -->
  <line x1="180" y1="114" x2="832" y2="114" stroke="#475569" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="506" y="108" text-anchor="middle" font-size="10" fill="#475569">agent/status running</text>

  <!-- 消息 4 -->
  <line x1="180" y1="130" x2="700" y2="130" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="124" text-anchor="middle" font-size="10" fill="#1a3a8a">turn/start（持久）</text>

  <!-- 消息 5 -->
  <line x1="180" y1="146" x2="832" y2="146" stroke="#475569" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="506" y="140" text-anchor="middle" font-size="10" fill="#475569">agent/inbox/claimed { message, turn }</text>

  <!-- 消息 6 -->
  <line x1="180" y1="162" x2="310" y2="162" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="245" y="156" text-anchor="middle" font-size="10" fill="#5b1a8a">agent/pre-step</text>

  <!-- 消息 7 -->
  <line x1="310" y1="178" x2="180" y2="178" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="245" y="172" text-anchor="middle" font-size="10" fill="#5b1a8a">reject | enter(messages)</text>

  <!-- 消息 8 -->
  <line x1="180" y1="194" x2="700" y2="194" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="188" text-anchor="middle" font-size="10" fill="#1a3a8a">step/start（持久）</text>

  <!-- 消息 9 -->
  <line x1="180" y1="210" x2="700" y2="210" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="204" text-anchor="middle" font-size="10" fill="#1a3a8a">user/message（每条进入的消息）</text>

  <!-- 消息 10 -->
  <line x1="180" y1="226" x2="440" y2="226" stroke="#e07b39" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="310" y="220" text-anchor="middle" font-size="10" fill="#8a3a00">agent/request → llm/stream</text>

  <!-- 消息 11 -->
  <line x1="440" y1="242" x2="180" y2="242" stroke="#e07b39" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="310" y="236" text-anchor="middle" font-size="10" fill="#8a3a00">StreamChunk* 流式返回</text>

  <!-- 消息 12 -->
  <line x1="180" y1="258" x2="700" y2="258" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="252" text-anchor="middle" font-size="10" fill="#1a3a8a">assistant/chunk* → assistant/message</text>

  <!-- 消息 13 -->
  <line x1="700" y1="274" x2="832" y2="274" stroke="#64748b" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="766" y="268" text-anchor="middle" font-size="10" fill="#64748b">session/event 广播</text>

  <!-- 消息 14 -->
  <line x1="180" y1="290" x2="570" y2="290" stroke="#27ae60" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="375" y="284" text-anchor="middle" font-size="10" fill="#1a5a2a">tool/call + 执行流水线</text>

  <!-- 消息 15 -->
  <line x1="570" y1="306" x2="700" y2="306" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="635" y="300" text-anchor="middle" font-size="10" fill="#1a3a8a">tool/result（持久）</text>

  <!-- 消息 16 -->
  <line x1="180" y1="322" x2="700" y2="322" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="316" text-anchor="middle" font-size="10" fill="#1a3a8a">step/end（持久）</text>

  <!-- 循环：驱动器上的自环 -->
  <path d="M 186 336 C 218 336, 218 370, 186 370" fill="none" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="232" y="358" font-size="10" fill="#5b1a8a">还有下一步输入 → 认领 → 再次 pre-step</text>

  <!-- 消息 17 -->
  <line x1="180" y1="370" x2="310" y2="370" stroke="#8e44ad" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="245" y="364" text-anchor="middle" font-size="10" fill="#5b1a8a">agent/turn-stopping（serial）</text>

  <!-- 消息 18 -->
  <line x1="180" y1="386" x2="700" y2="386" stroke="#2980b9" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="440" y="380" text-anchor="middle" font-size="10" fill="#1a3a8a">turn/end（持久）</text>

  <!-- 消息 19 -->
  <line x1="180" y1="402" x2="832" y2="402" stroke="#475569" stroke-width="1.5" marker-end="url(#stArrow)"/>
  <text x="506" y="396" text-anchor="middle" font-size="10" fill="#475569">agent/status idle</text>

  <!-- 注释 -->
  <rect x="30" y="430" width="880" height="140" rx="10" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
  <text x="50" y="452" font-size="11" font-weight="bold" fill="#334155">事件三域</text>
  <text x="50" y="474" font-size="10" fill="#64748b">会话事件（持久）：turn/start、step/start、user/message、assistant/*、tool/call、tool/result —— 追加进日志，回放可重建</text>
  <text x="50" y="494" font-size="10" fill="#64748b">Agent 事件（实时）：agent/pre-step、agent/request、agent/status、agent/turn-stopping —— 携带活跃 Agent，观察或拦截进行中的工作</text>
  <text x="50" y="514" font-size="10" fill="#64748b">能力事件（seam）：tools/*、fs/*、llm/stream —— 向能力 seam 附加策略与适配器</text>
  <text x="50" y="544" font-size="10" fill="#c2410c">模型可见即已记录：抵达模型请求的一切都必须能从日志重建</text>
  <text x="50" y="562" font-size="10" fill="#c2410c">agent/pre-step 决定模型看到什么；inbox 是输入队列，注入的上下文留在其中直到被唤醒</text>
</svg>
