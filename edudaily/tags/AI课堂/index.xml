      <title>纽约暂停60万中小学生用生成式AI，为期一年</title>
      <link>https://index.zshipu.com/edudaily/post/20260903/%E7%BA%BD%E7%BA%A6%E6%9A%82%E5%81%9C60%E4%B8%87%E4%B8%AD%E5%B0%8F%E5%AD%A6%E7%94%9F%E7%94%A8%E7%94%9F%E6%88%90%E5%BC%8FAI%E4%B8%BA%E6%9C%9F%E4%B8%80%E5%B9%B4/</link>
