      <title>AI重写负载后数据库必须同时处理动态查询与实时推理</title>
      <link>https://index.zshipu.com/geek001/post/20260902/AI%E9%87%8D%E5%86%99%E8%B4%9F%E8%BD%BD%E5%90%8E%E6%95%B0%E6%8D%AE%E5%BA%93%E5%BF%85%E9%A1%BB%E5%90%8C%E6%97%B6%E5%A4%84%E7%90%86%E5%8A%A8%E6%80%81%E6%9F%A5%E8%AF%A2%E4%B8%8E%E5%AE%9E%E6%97%B6%E6%8E%A8%E7%90%86/</link>
