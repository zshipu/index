      <title>一文掌握Prompt：万能框架&#43;优化技巧&#43;常用指标</title>
      <link>https://index.zshipu.com/geek001/post/20240723/%E4%B8%80%E6%96%87%E6%8E%8C%E6%8F%A1Prompt%E4%B8%87%E8%83%BD%E6%A1%86%E6%9E%B6&#43;%E4%BC%98%E5%8C%96%E6%8A%80%E5%B7%A7&#43;%E5%B8%B8%E7%94%A8%E6%8C%87%E6%A0%87--%E7%9F%A5%E8%AF%86%E9%93%BA/</link>
      <pubDate>Tue, 30 Jul 2024 11:39:51 +0000</pubDate>
