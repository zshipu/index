    <item>
      <title>阿里云实时计算Flink多行业应用实践</title>
      <link>https://index.zshipu.com/geek001/post/20240723/%E9%98%BF%E9%87%8C%E4%BA%91%E5%AE%9E%E6%97%B6%E8%AE%A1%E7%AE%97Flink%E5%A4%9A%E8%A1%8C%E4%B8%9A%E5%BA%94%E7%94%A8%E5%AE%9E%E8%B7%B5--%E7%9F%A5%E8%AF%86%E9%93%BA/</link>
