      <title>魏牌CEO称打造前所未有豪华方盒子SUV 切入高端硬派市场</title>
      <link>https://index.zshipu.com/geek001/post/20260904/%E9%AD%8F%E7%89%8CCEO%E7%A7%B0%E6%89%93%E9%80%A0%E5%89%8D%E6%89%80%E6%9C%AA%E6%9C%89%E8%B1%AA%E5%8D%8E%E6%96%B9%E7%9B%92%E5%AD%90SUV-%E5%88%87%E5%85%A5%E9%AB%98%E7%AB%AF%E7%A1%AC%E6%B4%BE%E5%B8%82%E5%9C%BA/</link>
