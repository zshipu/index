      <link>https://index.zshipu.com/geek001/post/20260906/%E5%BE%AE%E4%BF%A1-Linux-%E7%89%88%E8%8E%B7-4.1.13-%E6%9B%B4%E6%96%B0%E6%96%B0%E5%A2%9E%E8%AF%AD%E9%9F%B3%E8%BE%93%E5%85%A5%E6%96%87%E5%AD%97%E6%BB%9A%E5%8A%A8%E6%88%AA%E5%9B%BE%E7%AD%89%E5%AE%9E%E7%94%A8%E5%8A%9F%E8%83%BD/</link>
