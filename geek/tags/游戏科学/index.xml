    <item>
      <title>《黑神话：钟馗》实机演示解析：玩法落地，系列立住</title>
      <link>https://index.zshipu.com/geek/post/20260821/%E9%BB%91%E7%A5%9E%E8%AF%9D%E9%92%9F%E9%A6%97%E5%AE%9E%E6%9C%BA%E6%BC%94%E7%A4%BA%E8%A7%A3%E6%9E%90%E7%8E%A9%E6%B3%95%E8%90%BD%E5%9C%B0%E7%B3%BB%E5%88%97%E7%AB%8B%E4%BD%8F/</link>
