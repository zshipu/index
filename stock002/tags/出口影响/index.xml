    <item>
      <title>美联储高官Warsh释放加息信号 推高华尔街紧张情绪</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E7%BE%8E%E8%81%94%E5%82%A8%E9%AB%98%E5%AE%98Warsh%E9%87%8A%E6%94%BE%E5%8A%A0%E6%81%AF%E4%BF%A1%E5%8F%B7-%E6%8E%A8%E9%AB%98%E5%8D%8E%E5%B0%94%E8%A1%97%E7%B4%A7%E5%BC%A0%E6%83%85%E7%BB%AA/</link>
