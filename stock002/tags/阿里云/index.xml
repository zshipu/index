    <item>
      <title>一个 terraform apply 误删了整个 staging 数据库</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E4%B8%80%E4%B8%AA-terraform-apply-%E8%AF%AF%E5%88%A0%E4%BA%86%E6%95%B4%E4%B8%AA-staging-%E6%95%B0%E6%8D%AE%E5%BA%93/</link>
