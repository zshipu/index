      <title>宁德时代宜宾基地回应厕所事件：视频曝光后称不属本公司</title>
      <link>https://index.zshipu.com/stock002/post/20260909/%E5%AE%81%E5%BE%B7%E6%97%B6%E4%BB%A3%E5%AE%9C%E5%AE%BE%E5%9F%BA%E5%9C%B0%E5%9B%9E%E5%BA%94%E5%8E%95%E6%89%80%E4%BA%8B%E4%BB%B6%E8%A7%86%E9%A2%91%E6%9B%9D%E5%85%89%E5%90%8E%E7%A7%B0%E4%B8%8D%E5%B1%9E%E6%9C%AC%E5%85%AC%E5%8F%B8/</link>
