      <title>旺旺首季利润暴跌38% 创始人定性重大经营危机</title>
      <link>https://index.zshipu.com/stock002/post/20260831/%E6%97%BA%E6%97%BA%E9%A6%96%E5%AD%A3%E5%88%A9%E6%B6%A6%E6%9A%B4%E8%B7%8C38-%E5%88%9B%E5%A7%8B%E4%BA%BA%E5%AE%9A%E6%80%A7%E9%87%8D%E5%A4%A7%E7%BB%8F%E8%90%A5%E5%8D%B1%E6%9C%BA/</link>
