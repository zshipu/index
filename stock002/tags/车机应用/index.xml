      <title>极空间私有云接入比亚迪DiLink，实现车家NAS无缝互通</title>
      <link>https://index.zshipu.com/stock002/post/20260904/%E6%9E%81%E7%A9%BA%E9%97%B4%E7%A7%81%E6%9C%89%E4%BA%91%E6%8E%A5%E5%85%A5%E6%AF%94%E4%BA%9A%E8%BF%AADiLink%E5%AE%9E%E7%8E%B0%E8%BD%A6%E5%AE%B6NAS%E6%97%A0%E7%BC%9D%E4%BA%92%E9%80%9A/</link>
