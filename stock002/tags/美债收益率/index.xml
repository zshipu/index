    <item>
      <title>美债收益率创2025年1月新高 油价推高中国进口成本与汇率压力</title>
      <link>https://index.zshipu.com/stock002/post/20260901/%E7%BE%8E%E5%80%BA%E6%94%B6%E7%9B%8A%E7%8E%87%E5%88%9B2025%E5%B9%B41%E6%9C%88%E6%96%B0%E9%AB%98-%E6%B2%B9%E4%BB%B7%E6%8E%A8%E9%AB%98%E4%B8%AD%E5%9B%BD%E8%BF%9B%E5%8F%A3%E6%88%90%E6%9C%AC%E4%B8%8E%E6%B1%87%E7%8E%87%E5%8E%8B%E5%8A%9B/</link>
