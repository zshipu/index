    <item>
      <title>伯克希尔CEO警告：美国数据中心建设遭遇全国性强烈抵制</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E4%BC%AF%E5%85%8B%E5%B8%8C%E5%B0%94CEO%E8%AD%A6%E5%91%8A%E7%BE%8E%E5%9B%BD%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E5%BB%BA%E8%AE%BE%E9%81%AD%E9%81%87%E5%85%A8%E5%9B%BD%E6%80%A7%E5%BC%BA%E7%83%88%E6%8A%B5%E5%88%B6/</link>
