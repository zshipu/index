    <item>
      <title>Stellantis 不予置评玛莎拉蒂与华为江淮合作传闻</title>
      <link>https://index.zshipu.com/stock002/post/20260905/Stellantis-%E4%B8%8D%E4%BA%88%E7%BD%AE%E8%AF%84%E7%8E%9B%E8%8E%8E%E6%8B%89%E8%92%82%E4%B8%8E%E5%8D%8E%E4%B8%BA%E6%B1%9F%E6%B7%AE%E5%90%88%E4%BD%9C%E4%BC%A0%E9%97%BB/</link>
