    <item>
      <title>中海油半年净利润858亿 年化已超2022年历史峰值</title>
      <link>https://index.zshipu.com/stock002/post/20260903/%E4%B8%AD%E6%B5%B7%E6%B2%B9%E5%8D%8A%E5%B9%B4%E5%87%80%E5%88%A9%E6%B6%A6858%E4%BA%BF-%E5%B9%B4%E5%8C%96%E5%B7%B2%E8%B6%852022%E5%B9%B4%E5%8E%86%E5%8F%B2%E5%B3%B0%E5%80%BC/</link>
