      <title>库克卸任苹果CEO转任执行董事长 特努斯9月1日正式接棒</title>
      <link>https://index.zshipu.com/stock002/post/20260901/%E5%BA%93%E5%85%8B%E5%8D%B8%E4%BB%BB%E8%8B%B9%E6%9E%9CCEO%E8%BD%AC%E4%BB%BB%E6%89%A7%E8%A1%8C%E8%91%A3%E4%BA%8B%E9%95%BF-%E7%89%B9%E5%8A%AA%E6%96%AF9%E6%9C%881%E6%97%A5%E6%AD%A3%E5%BC%8F%E6%8E%A5%E6%A3%92/</link>
