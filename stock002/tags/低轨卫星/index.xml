    <item>
      <title>阿里巴巴入股垣信卫星，千帆星座已增至238颗卫星</title>
      <link>https://index.zshipu.com/stock002/post/20260904/%E9%98%BF%E9%87%8C%E5%B7%B4%E5%B7%B4%E5%85%A5%E8%82%A1%E5%9E%A3%E4%BF%A1%E5%8D%AB%E6%98%9F%E5%8D%83%E5%B8%86%E6%98%9F%E5%BA%A7%E5%B7%B2%E5%A2%9E%E8%87%B3238%E9%A2%97%E5%8D%AB%E6%98%9F/</link>
