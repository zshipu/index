      <title>大众汽车曝光147页重组文件：2031年起关闭4座德国工厂</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E5%A4%A7%E4%BC%97%E6%B1%BD%E8%BD%A6%E6%9B%9D%E5%85%89147%E9%A1%B5%E9%87%8D%E7%BB%84%E6%96%87%E4%BB%B62031%E5%B9%B4%E8%B5%B7%E5%85%B3%E9%97%AD4%E5%BA%A7%E5%BE%B7%E5%9B%BD%E5%B7%A5%E5%8E%82/</link>
