    <item>
      <title>A股三大指数走弱 家电板块爆发 银行股逆势活跃</title>
      <link>https://index.zshipu.com/stock002/post/20240430/A%E8%82%A1%E4%B8%89%E5%A4%A7%E6%8C%87%E6%95%B0%E8%B5%B0%E5%BC%B1-%E5%AE%B6%E7%94%B5%E6%9D%BF%E5%9D%97%E7%88%86%E5%8F%91-%E9%93%B6%E8%A1%8C%E8%82%A1%E9%80%86%E5%8A%BF%E6%B4%BB%E8%B7%83--%E7%9F%A5%E8%AF%86%E9%93%BA/</link>
