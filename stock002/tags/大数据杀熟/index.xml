    <item>
      <title>美国FTC严打大数据杀熟，个性化定价须明示</title>
      <link>https://index.zshipu.com/stock002/post/20260821/%E7%BE%8E%E5%9B%BDFTC%E4%B8%A5%E6%89%93%E5%A4%A7%E6%95%B0%E6%8D%AE%E6%9D%80%E7%86%9F%E4%B8%AA%E6%80%A7%E5%8C%96%E5%AE%9A%E4%BB%B7%E9%A1%BB%E6%98%8E%E7%A4%BA/</link>
