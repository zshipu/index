      <title>特努斯接棒库克，苹果还能定义下一代硬件吗</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E7%89%B9%E5%8A%AA%E6%96%AF%E6%8E%A5%E6%A3%92%E5%BA%93%E5%85%8B%E8%8B%B9%E6%9E%9C%E8%BF%98%E8%83%BD%E5%AE%9A%E4%B9%89%E4%B8%8B%E4%B8%80%E4%BB%A3%E7%A1%AC%E4%BB%B6%E5%90%97/</link>
