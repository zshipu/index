    <item>
      <title>10年期国债收益率升破4.9% 油价触及100美元推高通胀忧虑</title>
      <link>https://index.zshipu.com/stock002/post/20260910/10%E5%B9%B4%E6%9C%9F%E5%9B%BD%E5%80%BA%E6%94%B6%E7%9B%8A%E7%8E%87%E5%8D%87%E7%A0%B44.9-%E6%B2%B9%E4%BB%B7%E8%A7%A6%E5%8F%8A100%E7%BE%8E%E5%85%83%E6%8E%A8%E9%AB%98%E9%80%9A%E8%83%80%E5%BF%A7%E8%99%91/</link>
      <pubDate>Thu, 10 Sep 2026 00:00:00 +0000</pubDate>
