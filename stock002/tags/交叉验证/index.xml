      <title>时间序列验证分数常被高估，测试套件不会告诉你</title>
      <link>https://index.zshipu.com/stock002/post/20260902/%E6%97%B6%E9%97%B4%E5%BA%8F%E5%88%97%E9%AA%8C%E8%AF%81%E5%88%86%E6%95%B0%E5%B8%B8%E8%A2%AB%E9%AB%98%E4%BC%B0%E6%B5%8B%E8%AF%95%E5%A5%97%E4%BB%B6%E4%B8%8D%E4%BC%9A%E5%91%8A%E8%AF%89%E4%BD%A0/</link>
