      <title>特朗普警告：反对AI数据中心社区或将落后贫穷，中国成最大受益者</title>
      <link>https://index.zshipu.com/stock002/post/20260831/%E7%89%B9%E6%9C%97%E6%99%AE%E8%AD%A6%E5%91%8A%E5%8F%8D%E5%AF%B9AI%E6%95%B0%E6%8D%AE%E4%B8%AD%E5%BF%83%E7%A4%BE%E5%8C%BA%E6%88%96%E5%B0%86%E8%90%BD%E5%90%8E%E8%B4%AB%E7%A9%B7%E4%B8%AD%E5%9B%BD%E6%88%90%E6%9C%80%E5%A4%A7%E5%8F%97%E7%9B%8A%E8%80%85/</link>
