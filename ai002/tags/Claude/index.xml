    <item>
      <title>Claude Skills 社区仓库：Deep Research 真正好用的开源工具盘点</title>
      <link>https://index.zshipu.com/ai002/post/20260831/Claude-Skills-%E7%A4%BE%E5%8C%BA%E4%BB%93%E5%BA%93Deep-Research-%E7%9C%9F%E6%AD%A3%E5%A5%BD%E7%94%A8%E7%9A%84%E5%BC%80%E6%BA%90%E5%B7%A5%E5%85%B7%E7%9B%98%E7%82%B9/</link>
