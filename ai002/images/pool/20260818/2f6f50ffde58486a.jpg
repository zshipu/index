<svg viewBox="0 0 780 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:780px;display:block;margin:20px auto;">
  <defs>
    <filter id="sh3" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00000014"/>
    </filter>
    <marker id="pa2" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto" markerUnits="userSpaceOnUse">
      <path d="M0,1.5 L8,5 L0,8.5 z" fill="#8aa0c8"/>
    </marker>
  </defs>
  <rect width="780" height="430" rx="12" fill="#fafbff"/>

  <!-- Center: Cordis kernel -->
  <ellipse cx="390" cy="215" rx="118" ry="72" fill="#0d2b52" filter="url(#sh3)"/>
  <text x="390" y="205" text-anchor="middle" font-size="15" font-weight="bold" fill="#fff">Cordis 内核</text>
  <text x="390" y="225" text-anchor="middle" font-size="10" fill="#c8d8f5">插件加载 · 卸载 · 依赖管理</text>
  <text x="390" y="241" text-anchor="middle" font-size="10" fill="#c8d8f5">服务（Service）与事件（Event）</text>
  <text x="390" y="257" text-anchor="middle" font-size="10" fill="#c8d8f5">不承载任何 Agent 能力</text>

  <!-- connections: tail at box edge, arrow tip 4px outside ellipse boundary -->
  <line x1="310" y1="114" x2="314" y2="156" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="470" y1="114" x2="466" y2="156" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="192" y1="215" x2="268" y2="215" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="588" y1="215" x2="512" y2="215" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="198" y1="310" x2="281" y2="249" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="390" y1="330" x2="390" y2="291" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>
  <line x1="582" y1="310" x2="499" y2="249" stroke="#8aa0c8" stroke-width="1.2" stroke-dasharray="5,3" marker-end="url(#pa2)"/>

  <!-- Top row -->
  <rect x="210" y="52" width="150" height="62" rx="10" fill="#e8f5e9" stroke="#27ae60" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="285" y="78" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">模型 Model</text>
  <text x="285" y="96" text-anchor="middle" font-size="9" fill="#3a8a4a">LLM 适配器</text>

  <rect x="420" y="52" width="150" height="62" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="495" y="78" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">工具 Tools</text>
  <text x="495" y="96" text-anchor="middle" font-size="9" fill="#2a5aa0">文件 · Shell · 检索</text>

  <!-- Left / Right middle -->
  <rect x="42" y="184" width="150" height="62" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="117" y="210" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">会话 Sessions</text>
  <text x="117" y="228" text-anchor="middle" font-size="9" fill="#7a30b0">仅追加日志 · 恢复/分叉</text>

  <rect x="588" y="184" width="150" height="62" rx="10" fill="#fff3e8" stroke="#e07b39" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="663" y="210" text-anchor="middle" font-size="12" font-weight="bold" fill="#8a3a00">UI / 界面</text>
  <text x="663" y="228" text-anchor="middle" font-size="9" fill="#a04000">Web UI · CLI · SDK</text>

  <!-- Bottom row -->
  <rect x="60" y="310" width="150" height="62" rx="10" fill="#eafaf1" stroke="#27ae60" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="135" y="336" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a5a2a">沙箱 Sandbox</text>
  <text x="135" y="354" text-anchor="middle" font-size="9" fill="#2a7a3a">隔离执行 · 审批策略</text>

  <rect x="315" y="330" width="150" height="62" rx="10" fill="#e8f0ff" stroke="#2980b9" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="390" y="356" text-anchor="middle" font-size="12" font-weight="bold" fill="#1a3a8a">循环 Agent Loop</text>
  <text x="390" y="374" text-anchor="middle" font-size="9" fill="#2a5aa0">步骤 · 轮次 · 驱动</text>

  <rect x="570" y="310" width="150" height="62" rx="10" fill="#f5effe" stroke="#8e44ad" stroke-width="1.5" filter="url(#sh3)"/>
  <text x="645" y="336" text-anchor="middle" font-size="12" font-weight="bold" fill="#5b1a8a">存储 · 调度 · 技能</text>
  <text x="645" y="354" text-anchor="middle" font-size="9" fill="#7a30b0">持久化 · Cron · Skills</text>

  <text x="390" y="412" text-anchor="middle" font-size="10" fill="#888">任一插件都可在配置层替换、扩展，无需改动内核源码</text>
</svg>
