    {
      "@type": "Question",
      "name": "苹果审核健康医美类App时，个人开发者账号会被拒吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "会。由于涉及健康医疗，苹果强制要求此类App必须由公司或组织提交，个人账号极易被拒。因此开发前必须先确立开发者身份。"
      }
    },
    {
      "@type": "Question",
      "name": "心电图P波在II导联的正常形态和宽度是多少？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "P波代表心房除极，在II导联应直立圆润，宽度小于0.12秒。"
      }
    },
    {
      "@type": "Question",
      "name": "12导联系统中肢体导联和胸导联分别对应哪个面？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "肢体导联对应额面，胸导联对应横面。"
      }
    },
    {
      "@type": "Question",
      "name": "心率变异性检测在脑损伤后阵发性交感神经过度兴奋综合征评估中有何作用？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "心率变异性检测可用于辅助评估脑损伤后阵发性交感神经过度兴奋综合征，具体案例已发表于中国临床案例成果数据库。"
      }
    }
