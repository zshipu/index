    <item>
      <title>Anthropic Claude 11天自主完成费马大定理Lean形式化证明</title>
      <link>https://index.zshipu.com/ai001/post/20260905/Anthropic-Claude-11%E5%A4%A9%E8%87%AA%E4%B8%BB%E5%AE%8C%E6%88%90%E8%B4%B9%E9%A9%AC%E5%A4%A7%E5%AE%9A%E7%90%86Lean%E5%BD%A2%E5%BC%8F%E5%8C%96%E8%AF%81%E6%98%8E/</link>
