    <item>
      <title>HydraFusion 用多模型编排实现前沿质量与成本双赢</title>
      <link>https://index.zshipu.com/ai001/post/20260904/HydraFusion-%E7%94%A8%E5%A4%9A%E6%A8%A1%E5%9E%8B%E7%BC%96%E6%8E%92%E5%AE%9E%E7%8E%B0%E5%89%8D%E6%B2%BF%E8%B4%A8%E9%87%8F%E4%B8%8E%E6%88%90%E6%9C%AC%E5%8F%8C%E8%B5%A2/</link>
