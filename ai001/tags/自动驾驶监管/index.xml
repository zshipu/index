      <title>特斯拉Cybercab上路数小时即遭联邦调查 股价随即下跌</title>
      <link>https://index.zshipu.com/ai001/post/20260904/%E7%89%B9%E6%96%AF%E6%8B%89Cybercab%E4%B8%8A%E8%B7%AF%E6%95%B0%E5%B0%8F%E6%97%B6%E5%8D%B3%E9%81%AD%E8%81%94%E9%82%A6%E8%B0%83%E6%9F%A5-%E8%82%A1%E4%BB%B7%E9%9A%8F%E5%8D%B3%E4%B8%8B%E8%B7%8C/</link>
