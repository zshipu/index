      <title>云原生弹性能力正迁移为 Agent 时代的数据基座</title>
      <link>https://index.zshipu.com/ai001/post/20260901/%E4%BA%91%E5%8E%9F%E7%94%9F%E5%BC%B9%E6%80%A7%E8%83%BD%E5%8A%9B%E6%AD%A3%E8%BF%81%E7%A7%BB%E4%B8%BA-Agent-%E6%97%B6%E4%BB%A3%E7%9A%84%E6%95%B0%E6%8D%AE%E5%9F%BA%E5%BA%A7/</link>
