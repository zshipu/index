      <title>特朗普威胁停贸易逼降息 直指中美顺差或引发关税升级</title>
      <link>https://index.zshipu.com/ai001/post/20260904/%E7%89%B9%E6%9C%97%E6%99%AE%E5%A8%81%E8%83%81%E5%81%9C%E8%B4%B8%E6%98%93%E9%80%BC%E9%99%8D%E6%81%AF-%E7%9B%B4%E6%8C%87%E4%B8%AD%E7%BE%8E%E9%A1%BA%E5%B7%AE%E6%88%96%E5%BC%95%E5%8F%91%E5%85%B3%E7%A8%8E%E5%8D%87%E7%BA%A7/</link>
      <pubDate>Fri, 04 Sep 2026 00:00:00 +0000</pubDate>
