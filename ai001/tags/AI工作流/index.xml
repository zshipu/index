      <title>豆包改版后直接拖Skill就能跑，两个日常工作流详解</title>
      <link>https://index.zshipu.com/ai001/post/20260901/%E8%B1%86%E5%8C%85%E6%94%B9%E7%89%88%E5%90%8E%E7%9B%B4%E6%8E%A5%E6%8B%96Skill%E5%B0%B1%E8%83%BD%E8%B7%91%E4%B8%A4%E4%B8%AA%E6%97%A5%E5%B8%B8%E5%B7%A5%E4%BD%9C%E6%B5%81%E8%AF%A6%E8%A7%A3/</link>
