    <item>
      <title>Anthropic发布Model Hardware Standard，推动AI代理进入物理硬件</title>
      <link>https://index.zshipu.com/ai001/post/20260830/Anthropic%E5%8F%91%E5%B8%83Model-Hardware-Standard%E6%8E%A8%E5%8A%A8AI%E4%BB%A3%E7%90%86%E8%BF%9B%E5%85%A5%E7%89%A9%E7%90%86%E7%A1%AC%E4%BB%B6/</link>
