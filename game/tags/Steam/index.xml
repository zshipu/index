    <item>
      <title>育碧开始淡化Ubisoft Connect启动器地位 Steam版游戏将迎来更简洁启动体验</title>
      <link>https://index.zshipu.com/game/post/20260911/%E8%82%B2%E7%A2%A7%E5%BC%80%E5%A7%8B%E6%B7%A1%E5%8C%96Ubisoft-Connect%E5%90%AF%E5%8A%A8%E5%99%A8%E5%9C%B0%E4%BD%8D-Steam%E7%89%88%E6%B8%B8%E6%88%8F%E5%B0%86%E8%BF%8E%E6%9D%A5%E6%9B%B4%E7%AE%80%E6%B4%81%E5%90%AF%E5%8A%A8%E4%BD%93%E9%AA%8C/</link>
